cmd_tidy() {
  guard_not_canonical
  local refresh=0
  while (($#)); do
    case "$1" in
      --refresh) refresh=1; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) die 10 "unexpected positional: $1" ;;
    esac
  done
  local repo
  for repo in $(cfg_repos); do
    local canonical wt_root default_branch
    canonical=$(cfg_repo_get "$repo" path)
    wt_root=$(cfg_repo_get "$repo" worktree_root)
    default_branch=$(cfg_repo_get "$repo" default_branch)
    (( refresh == 1 )) && git_in "$canonical" fetch origin "$default_branch" --quiet 2>/dev/null || true
    printf '%s\n' "$(green "[$repo]") tidy report"
    {
      printf 'GROUP\tID\tBRANCH\tACTION\n'
      while IFS= read -r record; do
        wt_record_fields "$record" _repo id path _rp_path branch _sha is_canonical
        [[ "$is_canonical" == "worktree" ]] || continue
        [[ -n "$branch" ]] || branch="(detached)"
        local clean pushed reach group action
        is_clean "$path" && clean=yes || clean=no
        is_pushed "$path" && pushed=yes || pushed=no
        reachable_from "$path" "$default_branch" && reach=yes || reach=no
        if [[ "$clean" == "no" ]]; then
          group="active-dirty"; action="keep; commit/stash before reap"
        elif [[ "$pushed" == "yes" && "$reach" == "yes" ]]; then
          group="safe-reap-candidate"; action="wt reap $id"
        else
          group="needs-review"; action="inspect before reaping"
        fi
        printf '%s\t%s\t%s\t%s\n' "$group" "$id" "$branch" "$action"
      done < <(wt_each_worktree "$repo")
    } | column -t -s $'\t' | sed 's/^/  /'
  done
}

cmd_repair() {
  guard_forbidden
  local repo
  for repo in $(cfg_repos); do
    local canonical wt_root
    canonical=$(cfg_repo_get "$repo" path)
    wt_root=$(cfg_repo_get "$repo" worktree_root)
    info "[$repo] reconciling"
    wt_each_worktree "$repo" >/dev/null || true
    git_in "$canonical" worktree prune -v 2>&1 | sed 's/^/  /' || true
    if [[ -d "$wt_root/.wt.lock" ]]; then
      local locker ans
      locker=$(cat "$wt_root/.wt.lock/pid" 2>/dev/null || echo "?")
      if [[ "$locker" != "?" ]] && ! kill -0 "$locker" 2>/dev/null; then
        printf '  stale lock from dead pid %s — remove? [y/N] ' "$locker"
        read -r ans
        [[ "$ans" == "y" || "$ans" == "Y" ]] && rm -rf "$wt_root/.wt.lock" && green "    removed\n"
      fi
    fi
  done
}

cmd_onboard() {
  local path="${1:-$PWD}" yes=0 name_override=""
  shift || true
  while (($#)); do
    case "$1" in
      --yes|-y) yes=1; shift ;;
      --name) name_override="${2:-}"; shift 2 ;;
      *) die 10 "unknown flag: $1" ;;
    esac
  done

  path=$(rp "$path")
  [[ -d "$path" ]] || die 10 "not a directory: $path"
  git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || die 10 "not a git repo: $path"

  # Resolve to the canonical checkout (handles being inside a worktree).
  local canonical
  canonical=$(dirname "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)")

  local repo_name="${name_override:-$(basename "$canonical")}"
  # Sanitize the repo name for YAML keys: lowercase, alnum + dash/underscore only.
  local safe_name=$(printf %s "$repo_name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-' | tr -s '-' | sed -E 's/^-+|-+$//g')

  # Already configured?
  local existing
  existing=$(cfg_repo_get "$safe_name" path 2>/dev/null || echo "")
  if [[ -n "$existing" && "$existing" != "null" ]]; then
    if [[ "$(rp "$existing")" == "$canonical" ]]; then
      info "$(dim "already configured as '$safe_name' \u2192 $existing")"
      # Still rewire core.hooksPath if applicable.
    else
      die 10 "repo name '$safe_name' is taken by $existing (use --name <other>)"
    fi
  fi

  # Detect remote-tracked default branch.
  local default_branch
  default_branch=$(git -C "$canonical" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|^refs/remotes/origin/||') \
    || default_branch=""
  if [[ -z "$default_branch" ]]; then
    default_branch=$(git -C "$canonical" symbolic-ref --short HEAD 2>/dev/null || echo main)
  fi
  [[ -z "$default_branch" ]] && default_branch="main"

  # Detect team-managed core.hooksPath override.
  local local_hookspath
  local_hookspath=$(git -C "$canonical" config --local --get core.hooksPath 2>/dev/null || true)
  # Don't warn if the local hooksPath equals wt's own default (wt-managed, not team-managed).
  if [[ "$local_hookspath" == "$HOME/.config/git/hooks" ]]; then local_hookspath=""; fi

  local parent worktree_root
  local default_config_branch default_config_root default_config_workspace
default_config_branch=$(cfg_repo_get __defaults__ default_branch)
default_config_root=$(cfg_repo_get "$safe_name" worktree_root)
default_config_workspace=$(cfg_repo_get "$safe_name" he""rdr_workspace)

  # Plan
  cat >&2 <<EOF
[wt onboard]
  repo name:       $safe_name
  canonical path:  $canonical
  default branch:  $default_branch
  base:            origin/$default_branch
  worktree_root:   $default_config_root
  he""rdr_workspace: $default_config_workspace
  branch_patterns: inherited from defaults
EOF
  if [[ -n "$local_hookspath" ]]; then
    cat >&2 <<EOF

  $(yellow NOTE:) local core.hooksPath = '$local_hookspath' (team-managed).
  wt will respect this. Push-time/commit-time hook enforcement will NOT apply
  in this repo, but CLI commands (wt new, adopt, reap, etc.) will work.
EOF
  fi

  if (( yes == 0 )); then
    printf '\n[wt onboard] proceed? [y/N] ' >&2
    local ans; read -r ans || ans=""
    [[ "$ans" == "y" || "$ans" == "Y" ]] || die 10 "aborted"
  fi

  # Append compact repo config. Defaults provide worktree_root/base/default_branch/tab workspace/patterns.
  if [[ -z "$existing" || "$existing" == "null" ]]; then
    REPO="$safe_name" VALUE="$canonical" yq -i '.repos[strenv(REPO)].path = strenv(VALUE)' "$WT_CONFIG"
    if [[ "$default_branch" != "$default_config_branch" ]]; then
      REPO="$safe_name" VALUE="$default_branch" yq -i '.repos[strenv(REPO)].default_branch = strenv(VALUE)' "$WT_CONFIG"
      REPO="$safe_name" VALUE="origin/$default_branch" yq -i '.repos[strenv(REPO)].base = strenv(VALUE)' "$WT_CONFIG"
    fi
  fi
  _CFG_LOADED=0   # invalidate cache after config write
  # Regenerate path cache so hooks/prompt pick up the new repo.
  generate_path_cache
  green "added "
  printf 'repo=%s path=%s\n' "$safe_name" "$canonical"
}
cmd_plugin() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    install)
      cmd_plugin_install "$@"
      ;;
    link)
      cmd_plugin_link "$@"
      ;;
    list|ls)
      cmd_plugin_list "$@"
      ;;
    enable)
      cmd_plugin_enable "$@"
      ;;
    disable)
      cmd_plugin_disable "$@"
      ;;
    remove|rm)
      cmd_plugin_remove "$@"
      ;;
    emit)
      cmd_plugin_emit_manual "$@"
      ;;
    health)
      cmd_plugin_health "$@"
      ;;
    -h|--help|help|"")
      cat <<EOF
wt plugin — manage git-wt plugins (API: $WT_PLUGIN_API_VERSION)

usage:
  wt plugin install <repo>           clone wt-<name> plugin from github.com/<repo>
  wt plugin link <path>              register a local checkout as a plugin (for dev)
  wt plugin list                     installed plugins + enabled status
  wt plugin enable <name>            add plugin to enabled set
  wt plugin disable <name>           remove plugin from enabled set (keeps install)
  wt plugin remove <name>            delete the installed plugin
  wt plugin emit <name> <event>      manually fire an event to one plugin (debugging)
  wt plugin health [<name>]          run \`<plugin> health\` and print result

Plugin install path: $WT_PLUGIN_DIR
Active set config:   $WT_PLUGIN_CONFIG

See https://github.com/noamsiegel/git-wt#plugins for the contract.
EOF
      ;;
    *)
      die 10 "unknown subcommand: wt plugin $sub (try 'wt plugin --help')"
      ;;
  esac
}

cmd_plugin_install() {
  local repo="${1:-}"
  [[ -n "$repo" ]] || die 10 "usage: wt plugin install <owner/repo|url>"
  # Normalize: bare 'tmux' → noamsiegel/wt-tmux; owner/repo as-is; URL as-is.
  local url
  if [[ "$repo" == http*://* ]]; then
    url="$repo"
  elif [[ "$repo" == */* ]]; then
    url="https://github.com/$repo.git"
  else
    url="https://github.com/noamsiegel/wt-$repo.git"
  fi
  local name="${repo##*/}"
  name="${name#wt-}"
  local target="$WT_PLUGIN_DIR/wt-$name"

  mkdir -p "$WT_PLUGIN_DIR"
  if [[ -d "$target" ]]; then
    die 20 "plugin 'wt-$name' is already installed at $target — remove it first"
  fi

  info "→ cloning $url → $target"
  if ! git clone --depth 1 "$url" "$target" >/dev/null 2>&1; then
    die 30 "git clone failed for $url"
  fi

  # Verify the plugin shape.
  local exe="$target/wt-$name"
  local manifest="$target/wt-plugin.json"
  if [[ ! -x "$exe" ]]; then
    rm -rf "$target"
    die 20 "plugin clone is missing executable 'wt-$name' at the root"
  fi
  if [[ ! -r "$manifest" ]]; then
    warn "plugin has no wt-plugin.json manifest; event routing will fall back to running every event"
  fi

  wt_plugin_config_enable "$name"
  green "installed and enabled "
  printf '%s\n' "$name"
}

cmd_plugin_link() {
  local src="${1:-}"
  [[ -n "$src" ]] || die 10 "usage: wt plugin link <path-to-plugin-checkout>"
  src=$(realpath "$src" 2>/dev/null || die 20 "path not found: $1")
  [[ -d "$src" ]] || die 20 "not a directory: $src"

  local name
  name=$(basename "$src")
  name="${name#wt-}"

  mkdir -p "$WT_PLUGIN_DIR"
  local target="$WT_PLUGIN_DIR/wt-$name"
  if [[ -e "$target" ]]; then
    die 20 "plugin 'wt-$name' already linked/installed; remove it first"
  fi

  ln -s "$src" "$target"
  wt_plugin_config_enable "$name"
  green "linked and enabled "
  printf '%s → %s\n' "$name" "$src"
}

cmd_plugin_list() {
  if [[ ! -d "$WT_PLUGIN_DIR" ]]; then
    echo "no plugins installed (plugin dir: $WT_PLUGIN_DIR)"
    return 0
  fi
  printf '%-20s %-10s %-10s %s\n' NAME ENABLED KIND PATH
  local name p kind enabled
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    p="$WT_PLUGIN_DIR/wt-$name"
    if [[ -L "$p" ]]; then kind=link; else kind=clone; fi
    if wt_plugin_is_enabled "$name"; then enabled="yes"; else enabled="no"; fi
    printf '%-20s %-10s %-10s %s\n' "$name" "$enabled" "$kind" "$p"
  done < <(wt_plugin_list_installed)
}

cmd_plugin_enable() {
  local name="${1:-}"
  [[ -n "$name" ]] || die 10 "usage: wt plugin enable <name>"
  [[ -d "$WT_PLUGIN_DIR/wt-$name" ]] || die 20 "no plugin 'wt-$name' installed"
  wt_plugin_config_enable "$name"
  green "enabled "; printf '%s\n' "$name"
}

cmd_plugin_disable() {
  local name="${1:-}"
  [[ -n "$name" ]] || die 10 "usage: wt plugin disable <name>"
  wt_plugin_config_disable "$name"
  green "disabled "; printf '%s\n' "$name"
}

cmd_plugin_remove() {
  local name="${1:-}"
  [[ -n "$name" ]] || die 10 "usage: wt plugin remove <name>"
  local target="$WT_PLUGIN_DIR/wt-$name"
  [[ -e "$target" ]] || die 20 "no plugin 'wt-$name' installed"
  wt_plugin_config_disable "$name" 2>/dev/null || true
  if [[ -L "$target" ]]; then rm "$target"; else rm -rf "$target"; fi
  green "removed "; printf '%s\n' "$name"
}

cmd_plugin_emit_manual() {
  local name="${1:-}" event="${2:-}"
  [[ -n "$name" && -n "$event" ]] || die 10 "usage: wt plugin emit <name> <event> [--id <id>]"
  shift 2
  local id="" path="" branch=""
  while (($#)); do
    case "$1" in
      --id) id="${2:-}"; shift 2 ;;
      --path) path="${2:-}"; shift 2 ;;
      --branch) branch="${2:-}"; shift 2 ;;
      *) die 10 "unknown flag: $1" ;;
    esac
  done
  local exe; exe=$(wt_plugin_path "$name") || die 20 "no plugin 'wt-$name' installed"
  [[ -n "$exe" ]] || die 20 "no plugin 'wt-$name' installed"
  local payload reason=""
  case "$event" in
    wt:worktree-created|wt:focus) ;;
    wt:worktree-removed) reason="manual" ;;
    *) die 10 "unknown event: $event" ;;
  esac
  payload=$(_wt_plugin_lifecycle_payload "$event" "" "$id" "$path" "$branch" "$reason")
  info "→ sending $event to wt-$name"
  printf '%s\n' "$payload" | "$exe" event "$event"
}

cmd_plugin_health() {
  local name="${1:-}"
  if [[ -n "$name" ]]; then
    local exe; exe=$(wt_plugin_path "$name") || die 20 "no plugin 'wt-$name' installed"
    [[ -n "$exe" ]] || die 20 "no plugin 'wt-$name' installed"
    "$exe" health
    return 0
  fi
  # No name → run health on every installed plugin.
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    local exe; exe=$(wt_plugin_path "$name") || continue
    [[ -n "$exe" ]] || continue
    printf '%s: ' "$name"
    "$exe" health || true
  done < <(wt_plugin_list_installed)
}

cmd_help() {
  cat <<EOF
wt $WT_VERSION — worktree CLI

  wt new <branch>              create new worktree branched from <base>
  wt adopt <branch> [--id <id>]  move an existing branch into a worktree
  wt pr <number>               create worktree for inbound PR (fetches pull/<n>/head)
  wt list                      list worktrees per configured repo
  wt status [--refresh]        list + reap-eligibility (clean/pushed/reachable/tab)
  wt reap [--force] [--dry-run] <id>...  remove worktree + close tab + delete branch
  wt cd <id>                   print absolute worktree path (use: cd "\$(wt cd ABC-123)")
  wt focus <id>                focus tab plugin for worktree
  wt resume <id>               focus or create tab, then print cd command
  wt close-tab [--force] <id>  close tab only; keep worktree + branch
  wt tidy [--refresh]          group worktrees by cleanup action
  wt audit [--no-fetch]        list unmerged worktree branches (TSV, machine-readable)
  wt repair                    reconcile drift (missing tabs, orphan tabs, stale locks)
  wt doctor [--install-hooks]  self-check; --install-hooks (re)writes the path cache
  wt onboard [<path>] [--name <n>] [--yes]  add a git repo to ~/.config/wt/config.yaml (defaults to \$PWD)
  wt version [--latest]        print version; --latest checks upstream
  wt upgrade                   git pull in the install dir + re-symlink
  wt plugin <sub> [args]       manage plugins; \`wt plugin --help\` for details

Config: $WT_CONFIG
Cache:  $WT_CACHE
Spec:   ~/.pai/plans/wt-worktree-cli.md
Emergency push bypass: git push --no-verify
EOF
}

# ---------- upgrade / version ----------

# Resolve the directory where the wt binary lives. Follows the symlink
# chain so the user can install wt via a symlink (~/.local/bin/wt → ...).
wt_install_dir() {
  local self
  self=$(realpath "$0" 2>/dev/null || echo "$0")
  dirname "$self"
}

cmd_version() {
  local check_latest=0
  while (($#)); do
    case "$1" in
      --latest) check_latest=1; shift ;;
      *) die 10 "unknown flag: $1" ;;
    esac
  done
  echo "wt $WT_VERSION"
  (( check_latest == 0 )) && return 0

  # Check upstream. Use the install dir's git remote if it's a clone, else
  # fall back to the canonical upstream.
  local install_dir upstream_sha local_sha
  install_dir=$(wt_install_dir)
  if [[ -d "$install_dir/.git" ]] || [[ -f "$install_dir/.git" ]]; then
    local_sha=$(git -C "$install_dir" rev-parse HEAD 2>/dev/null || echo "")
    upstream_sha=$(git -C "$install_dir" ls-remote origin HEAD 2>/dev/null | awk '{print $1}' || echo "")
  else
    # Not a git checkout; query upstream directly.
    upstream_sha=$(git ls-remote https://github.com/noamsiegel/git-wt.git HEAD 2>/dev/null | awk '{print $1}' || echo "")
  fi

  if [[ -z "$upstream_sha" ]]; then
    yellow "warn:" >&2; echo " could not reach upstream (network/GitHub down?)" >&2
    return 0
  fi
  if [[ -n "$local_sha" && "$local_sha" != "$upstream_sha" ]]; then
    yellow "update available" >&2
    printf '  local:    %s\n' "$local_sha" >&2
    printf '  upstream: %s\n' "$upstream_sha" >&2
    printf '  run: wt upgrade\n' >&2
  elif [[ "$local_sha" == "$upstream_sha" ]]; then
    green "up to date " >&2; echo "($local_sha)" >&2
  else
    green "upstream HEAD: " >&2; echo "$upstream_sha (not a local clone — install via clone+symlink to enable wt upgrade)" >&2
  fi
}

cmd_upgrade() {
  local install_dir
  install_dir=$(wt_install_dir)
  if [[ ! -d "$install_dir/.git" ]] && [[ ! -f "$install_dir/.git" ]]; then
    die 30 "wt is not installed via a git clone — cannot auto-upgrade.
Install method that supports upgrades:
  git clone https://github.com/noamsiegel/git-wt.git ~/.local/share/git-wt
  ln -sf ~/.local/share/git-wt/git-wt ~/.local/bin/wt
Or upgrade manually by re-installing from https://github.com/noamsiegel/git-wt"
  fi

  info "→ install dir: $install_dir"
  local before_sha after_sha
  before_sha=$(git -C "$install_dir" rev-parse HEAD)

  info "→ git fetch origin"
  if ! git -C "$install_dir" fetch --quiet origin; then
    die 30 "git fetch failed — network/permissions?"
  fi

  # Check for dirty worktree before pull.
  if ! git -C "$install_dir" diff --quiet HEAD --; then
    yellow "warn:" >&2; echo " install dir has local modifications — refusing to pull. Stash/commit first." >&2
    exit 30
  fi

  info "→ git pull --ff-only"
  if ! git -C "$install_dir" pull --ff-only --quiet origin; then
    die 30 "git pull failed — branch may have diverged. Resolve manually in $install_dir"
  fi

  after_sha=$(git -C "$install_dir" rev-parse HEAD)
  if [[ "$before_sha" == "$after_sha" ]]; then
    green "already up to date "; echo "($after_sha)"
    return 0
  fi

  green "upgraded "; printf '%s → %s\n' "$before_sha" "$after_sha"

  # Re-run version to show the new version + any release-note hint.
  "$0" version
}

# ---------- dispatch ----------
main() {
  require_deps
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    new) cmd_new "$@" ;;
    adopt) cmd_adopt "$@" ;;
    pr) cmd_pr "$@" ;;
    list|ls) cmd_list "$@" ;;
    status|st) cmd_status "$@" ;;
    reap|rm) cmd_reap "$@" ;;
    cd) cmd_cd "$@" ;;
    focus) cmd_focus "$@" ;;
    resume) cmd_resume "$@" ;;
    close-tab|close) cmd_close_tab "$@" ;;
    tidy) cmd_tidy "$@" ;;
    audit) cmd_audit "$@" ;;
    repair) cmd_repair "$@" ;;
    doctor) cmd_doctor "$@" ;;
    onboard) cmd_onboard "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    version) cmd_version "$@" ;;
    plugin) cmd_plugin "$@" ;;
    -h|--help|help) cmd_help ;;
    --version|-V) cmd_version ;;
    *) cmd_help; exit 10 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
