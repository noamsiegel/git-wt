cmd_close_tab() {
  guard_forbidden
  herdr_available || die 30 "wt close-tab requires herdr (tab management)"
  local force=0 id=""
  while (($#)); do
    case "$1" in
      --force) force=1; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) [[ -z "$id" ]] && id="$1" || die 10 "unexpected positional: $1"; shift ;;
    esac
  done
  [[ -n "$id" ]] || die 10 "usage: wt close-tab [--force] <id>"
  local repo
  repo=$(repo_for_id "$id") || die 20 "no worktree '$id' in any configured repo"
  local wt_root path ws_name ws_id tab_id stt
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  ws_name=$(cfg_repo_get "$repo" herdr_workspace)
  path="$wt_root/$id"
  ws_id=$(herdr_ws_id "$ws_name" || true)
  [[ -n "$ws_id" ]] || die 30 "herdr workspace '$ws_name' not found"
  tab_id=$(herdr_pane_for_cwd "$ws_id" "$path" || true)
  if [[ -z "$tab_id" ]]; then
    printf 'no tab for %s\n' "$id"
    return 0
  fi
  stt=$(herdr_tab_status "$ws_id" "$tab_id")
  if [[ "$stt" == "working" && "$force" == "0" ]]; then
    die 70 "tab $tab_id has agent_status=working; use --force to close anyway"
  fi
  herdr_close_tab "$tab_id" || die 30 "could not close herdr tab $tab_id"
  green "closed "
  printf '%s (%s)\n' "$tab_id" "$id"
}

cmd_resume() {
  guard_forbidden
  local id="${1:-}"
