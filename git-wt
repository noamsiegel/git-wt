# ---------- upgrade / version ----------

# Resolve the directory where the wt binary lives. Follows the symlink
# chain so the user can install wt via a symlink (~/.local/bin/wt → ...).
wt_install_dir() {
  local self
  self=$(realpath "$0" 2>/dev/null || echo "$0")
  dirname "$self"
}

cmd_version() {
  local check_latest=0
  while (($#)); do
    case "$1" in
      --latest) check_latest=1; shift ;;
      *) die 10 "unknown flag: $1" ;;
    esac
  done
  echo "wt $WT_VERSION"
  (( check_latest == 0 )) && return 0

  # Check upstream. Use the install dir's git remote if it's a clone, else
  # fall back to the canonical upstream.
  # Default to empty: the non-clone branch below sets only upstream_sha, and
  # the comparisons read $local_sha unconditionally under `set -u`.
  local install_dir upstream_sha="" local_sha=""
  install_dir=$(wt_install_dir)
  if [[ -d "$install_dir/.git" ]] || [[ -f "$install_dir/.git" ]]; then
    local_sha=$(git -C "$install_dir" rev-parse HEAD 2>/dev/null || echo "")
    upstream_sha=$(git -C "$install_dir" ls-remote origin HEAD 2>/dev/null | awk '{print $1}' || echo "")
  else
    # Not a git checkout; query upstream directly.
    upstream_sha=$(git ls-remote https://github.com/noamsiegel/git-wt.git HEAD 2>/dev/null | awk '{print $1}' || echo "")
  fi

  if [[ -z "$upstream_sha" ]]; then
    yellow "warn:" >&2; echo " could not reach upstream (network/GitHub down?)" >&2
    return 0
  fi
  if [[ -n "$local_sha" && "$local_sha" != "$upstream_sha" ]]; then
    yellow "update available" >&2
    printf '  local:    %s\n' "$local_sha" >&2
    printf '  upstream: %s\n' "$upstream_sha" >&2
    printf '  run: wt upgrade\n' >&2
  elif [[ "$local_sha" == "$upstream_sha" ]]; then
    green "up to date " >&2; echo "($local_sha)" >&2
  else
    green "upstream HEAD: " >&2; echo "$upstream_sha (not a local clone — install via clone+symlink to enable wt upgrade)" >&2
  fi
}

cmd_upgrade() {
  local install_dir
  install_dir=$(wt_install_dir)
  if [[ ! -d "$install_dir/.git" ]] && [[ ! -f "$install_dir/.git" ]]; then
    die 30 "wt is not installed via a git clone — cannot auto-upgrade.
Install method that supports upgrades:
  git clone https://github.com/noamsiegel/git-wt.git ~/.local/share/git-wt
  ln -sf ~/.local/share/git-wt/git-wt ~/.local/bin/wt
Or upgrade manually by re-installing from https://github.com/noamsiegel/git-wt"
  fi

  info "→ install dir: $install_dir"
  local before_sha after_sha
  before_sha=$(git -C "$install_dir" rev-parse HEAD)

  info "→ git fetch origin"
  if ! git -C "$install_dir" fetch --quiet origin; then
    die 30 "git fetch failed — network/permissions?"
  fi

  # Check for dirty worktree before pull.
  if ! git -C "$install_dir" diff --quiet HEAD --; then
    yellow "warn:" >&2; echo " install dir has local modifications — refusing to pull. Stash/commit first." >&2
    exit 30
  fi

  info "→ git pull --ff-only"
  if ! git -C "$install_dir" pull --ff-only --quiet origin; then
    die 30 "git pull failed — branch may have diverged. Resolve manually in $install_dir"
  fi

  after_sha=$(git -C "$install_dir" rev-parse HEAD)
  if [[ "$before_sha" == "$after_sha" ]]; then
    green "already up to date "; echo "($after_sha)"
    return 0
  fi

  green "upgraded "; printf '%s → %s\n' "$before_sha" "$after_sha"

  # Re-run version to show the new version + any release-note hint.
  "$0" version
}

# ---------- hook dispatcher ----------

# Pure, self-contained git-hook guardrail invoked by the per-repo dispatcher
# (`wt hook-run <hook> [args]`). Fail-OPEN: any uncertainty exits 0 so a broken
# wt never blocks a commit/push. Runs before require_deps/require_config.
cmd_hook_run() {
  local hook="${1:-}"; shift || true
  have git || exit 0
  case "$hook" in
    pre-commit)
      local gd cd top repo cpath
      gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || exit 0
      cd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
      [[ "$gd" == "$cd" ]] || exit 0   # in a worktree -> allow
      top=$(rp "$(dirname "$cd")")
      for repo in $(cfg_repos 2>/dev/null); do
        cpath=$(rp "$(cfg_repo_get "$repo" path 2>/dev/null)")
        if [[ "$cpath" == "$top" ]]; then
          printf '\n%b\n' "$(red '=== wt: refusing to commit in canonical checkout ===')" >&2
          printf ' repo: %s\n path: %s\n' "$repo" "$top" >&2
          printf '\n canonical is read-only - work belongs in a worktree.\n' >&2
          printf ' fix: wt adopt %s\n' "$(git rev-parse --abbrev-ref HEAD)" >&2
          printf ' or: wt new <branch>\n' >&2
          printf '\n emergency bypass: git commit --no-verify\n\n' >&2
          exit 1
        fi
      done
      exit 0
      ;;
    pre-push)
      [[ "$(cfg_hook_enforce_branch_names 2>/dev/null)" == "true" ]] || exit 0
      local cd top repo r cpath
      cd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
      top=$(rp "$(dirname "$cd")")
      repo=""
      for r in $(cfg_repos 2>/dev/null); do
        cpath=$(rp "$(cfg_repo_get "$r" path 2>/dev/null)")
        [[ "$cpath" == "$top" ]] && { repo="$r"; break; }
      done
      [[ -n "$repo" ]] || exit 0
      local branch fail=0 local_ref local_sha remote_ref remote_sha
      while read -r local_ref local_sha remote_ref remote_sha; do
        [[ -z "$local_ref" ]] && continue
        branch="${local_ref#refs/heads/}"
        [[ "$local_ref" == "$branch" ]] && continue
        [[ "$local_sha" =~ ^0+$ ]] && continue
        if branch_policy_allows "$repo" "$branch"; then
          continue
        fi
        printf '%b: %s\n' "$(red 'wt pre-push: rejected branch name')" "$branch" >&2
        fail=1
      done
      (( fail == 0 )) || exit 1
      exit 0
      ;;
    post-checkout)
      [[ "${3:-}" == "1" ]] || exit 0
      [[ -z "${WT_POST_CHECKOUT_RESTORE:-}" ]] || exit 0

      local gd cd top repo r cpath default_branch current_branch
      gd=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || exit 0
      cd=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
      [[ "$gd" == "$cd" ]] || exit 0
      top=$(rp "$(dirname "$cd")")
      repo=""
      for r in $(cfg_repos 2>/dev/null); do
        cpath=$(rp "$(cfg_repo_get "$r" path 2>/dev/null)")
        [[ "$cpath" == "$top" ]] && { repo="$r"; break; }
      done
      [[ -n "$repo" ]] || exit 0

      default_branch=$(cfg_repo_get "$repo" default_branch 2>/dev/null) || exit 0
      current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
      [[ "$current_branch" != "$default_branch" ]] || exit 0
      if WT_POST_CHECKOUT_RESTORE=1 git switch --quiet "$default_branch"; then
        printf "wt post-checkout: canonical checkout restored to '%s'; use 'wt new <branch>' or 'wt adopt %s' for work.\n" \
          "$default_branch" "$current_branch" >&2
      else
        warn "post-checkout: could not restore canonical checkout to '$default_branch'; resolve checkout state, then run: git switch $default_branch"
      fi
      # The nested restore dispatches the team post-checkout hook for the
      # actual final checkout. Stop the outer stale event to avoid a double run.
      return 1
      ;;
    *) exit 0 ;;
  esac
}

# Resolve a repo arg (--repo <n>) or infer from $PWD. Echoes the repo name.
_hook_target_repo() {
  local repo="$1"
  if [[ -z "$repo" ]]; then
    local ctx; ctx=$(repo_for_cwd) || die 10 "specify --repo <name> or run inside a configured repo"
    repo="${ctx%% *}"
  fi
  cfg_repo_get "$repo" path >/dev/null 2>&1 || true
  local p; p=$(cfg_repo_get "$repo" path)
  [[ -n "$p" && "$p" != "null" ]] || die 10 "unknown repo: $repo"
  echo "$repo"
}

# Route a repo's git hooks through the wt guard (then its existing hooks) by
# pointing the repo's LOCAL core.hooksPath at a generated dispatcher dir. This
# restores wt's canonical-refuse guard in repos whose local hooksPath would
# otherwise bypass wt's global hooks (e.g. a team-managed .githooks).
cmd_install_hooks() {
  local repo=""
  while (($#)); do case "$1" in --repo) repo="${2:-}"; shift ;; *) die 10 "unknown flag: $1" ;; esac; shift; done
  repo=$(_hook_target_repo "$repo")
  local canonical; canonical=$(cfg_repo_get "$repo" path)
  [[ -d "$canonical/.git" || -f "$canonical/.git" ]] || die 10 "not a git repo: $canonical"

  local disp="$HOME/.config/wt/repo-hooks/$repo"
  local cur orig
  cur=$(git_in "$canonical" config --local --get core.hooksPath 2>/dev/null || true)
  if [[ "$cur" == "$disp" ]]; then
    orig=""
    [[ -r "$disp/.wt-orig-hookspath" ]] && orig=$(cat "$disp/.wt-orig-hookspath")
  else
    orig="$cur" # may be empty (git default)
  fi

  local orig_dir
  if [[ -z "$orig" ]]; then orig_dir="$canonical/.git/hooks"
  elif [[ "$orig" = /* ]]; then orig_dir="$orig"
  else orig_dir="$canonical/$orig"; fi

  mkdir -p "$disp"
  printf '%s' "$orig" > "$disp/.wt-orig-hookspath"

  local wt_bin; wt_bin=$(command -v wt 2>/dev/null || rp "${BASH_SOURCE[0]}")
  sed "s|__WT_BIN__|$wt_bin|g" > "$disp/_wt-dispatch" <<'DISP'
#!/usr/bin/env bash
# Generated by `wt install-hooks`. Runs the wt guardrail, then chains the repo's
# original hooks (the dir core.hooksPath pointed at before install). Do not edit.
set -e
hook=$(basename "$0")
here=$(cd "$(dirname "$0")" && pwd)
WT_BIN="__WT_BIN__"
orig=""; [[ -r "$here/.wt-orig-hookspath" ]] && orig=$(cat "$here/.wt-orig-hookspath")

tmp=$(mktemp -t wt-disp.XXXXXX 2>/dev/null || true)
if [[ -n "$tmp" ]]; then trap 'rm -f "$tmp"' EXIT; cat > "$tmp"; src="$tmp"; else src=/dev/null; fi

# 1) wt guardrail — blocks the operation on a non-zero exit.
[[ -x "$WT_BIN" ]] && "$WT_BIN" hook-run "$hook" "$@" < "$src"

# 2) chain the repo's original hook for this name, if any.
if [[ -z "$orig" ]]; then team_dir="$(git rev-parse --git-common-dir 2>/dev/null)/hooks"
elif [[ "$orig" = /* ]]; then team_dir="$orig"
else team_dir="$(git rev-parse --show-toplevel 2>/dev/null)/$orig"; fi
team="$team_dir/$hook"
if [[ -x "$team" && "$(realpath "$team" 2>/dev/null)" != "$(realpath "$0" 2>/dev/null)" ]]; then
  exec "$team" "$@" < "$src"
fi
exit 0
DISP
  chmod +x "$disp/_wt-dispatch"

  # Drop any stale hook symlinks from a previous install before regenerating.
  find "$disp" -maxdepth 1 -type l -delete 2>/dev/null || true

  local names=(pre-commit pre-push post-checkout) f n seen=" "
  if [[ -d "$orig_dir" ]]; then
    for f in "$orig_dir"/*; do
      [[ -e "$f" ]] || continue
      [[ -d "$f" ]] && continue                       # skip dirs (e.g. __pycache__)
      n=$(basename "$f")
      [[ "$n" == _wt* || "$n" == *.* ]] && continue   # skip helpers, dotfiles, *.sample, *.py, etc.
      [[ -x "$f" ]] || continue
      names+=("$n")
    done
  fi
  for n in "${names[@]}"; do
    [[ "$seen" == *" $n "* ]] && continue
    seen+="$n "
    ln -sf "_wt-dispatch" "$disp/$n"
  done

  git_in "$canonical" config --local core.hooksPath "$disp"
  green "installed "; printf 'wt hook dispatcher for %s\n' "$repo"
  info "$(dim "  dispatcher:    $disp")"
  info "$(dim "  chains hooks:  ${orig:-<git default .git/hooks>}")"
  info "$(dim "  guarded hooks: ${seen# }")"

  # If the repo's .envrc manages core.hooksPath, direnv re-applies it on every
  # load and would clobber the dispatcher. Persist the override in the user-local
  # file the .envrc sources last (e.g. .envrc-personal) so it wins.
  local envrc="$canonical/.envrc" local_src override_target
  if [[ -f "$envrc" ]] && grep -qE 'core\.hooksPath' "$envrc"; then
    local_src=$(grep -oE 'source_env(_if_exists)?[[:space:]]+[^[:space:]#]+' "$envrc" | tail -1 | awk '{print $NF}' | tr -d "\"'" || true)
    if [[ -n "$local_src" ]]; then
      override_target="$canonical/$local_src"
      if grep -q "repo-hooks/$repo\"" "$override_target" 2>/dev/null; then
        info "$(dim "  .envrc manages core.hooksPath → override already in $local_src")"
      else
        printf '\n# wt install-hooks: re-assert the wt dispatcher after .envrc sets core.hooksPath\ngit config --local core.hooksPath "%s"\n' "$disp" >> "$override_target"
        info "$(dim "  .envrc manages core.hooksPath → wrote override to $local_src")"
      fi
      if have direnv; then ( cd "$canonical" && direnv allow . >/dev/null 2>&1 ) || true; fi
    else
      warn ".envrc sets core.hooksPath but sources no user-local file; the dispatcher may be overridden on direnv load (see README)."
    fi
  fi
}

# Restore a repo's original core.hooksPath and remove the wt dispatcher dir.
cmd_uninstall_hooks() {
  local repo=""
  while (($#)); do case "$1" in --repo) repo="${2:-}"; shift ;; *) die 10 "unknown flag: $1" ;; esac; shift; done
  repo=$(_hook_target_repo "$repo")
  local canonical; canonical=$(cfg_repo_get "$repo" path)
  local disp="$HOME/.config/wt/repo-hooks/$repo"
  local cur; cur=$(git_in "$canonical" config --local --get core.hooksPath 2>/dev/null || true)
  if [[ "$cur" == "$disp" ]]; then
    local orig=""; [[ -r "$disp/.wt-orig-hookspath" ]] && orig=$(cat "$disp/.wt-orig-hookspath")
    if [[ -n "$orig" ]]; then
      git_in "$canonical" config --local core.hooksPath "$orig"
    else
      git_in "$canonical" config --local --unset core.hooksPath 2>/dev/null || true
    fi
    green "uninstalled "; printf 'restored core.hooksPath for %s → %s\n' "$repo" "${orig:-<git default>}"
  else
    warn "core.hooksPath for $repo is '${cur:-<unset>}', not the wt dispatcher; leaving git config unchanged"
  fi
  [[ -d "$disp" ]] && rm -rf "$disp"
  return 0
}

# ---------- dispatch ----------
main() {
  local sub="${1:-help}"
  shift || true

  # hook-run is invoked by the generated per-repo dispatcher on every commit/
  # push. It must be fast and fail-open, so it bypasses dep/config checks.
  if [[ "$sub" == "hook-run" ]]; then cmd_hook_run "$@"; return; fi

  require_deps

  # Skip the require_config check for commands that don't operate on the
  # configured worktree set. Lets users run `wt --version`, `wt --help`,
  # `wt onboard`, and `wt plugin validate <path>` before any wt config
  # exists at $WT_CONFIG.
  case "$sub" in
    -h|--help|help|--version|-V|version|onboard|upgrade) ;;
    plugin)
      # plugin validate <path> doesn't need wt config (it operates on the
      # given plugin path only). Other plugin subcommands write to the
      # plugin dir but also don't need wt config.
      ;;
    *) require_config ;;
  esac

  case "$sub" in
    new) cmd_new "$@" ;;
    adopt) cmd_adopt "$@" ;;
    move|mv) cmd_move "$@" ;;
    pr) cmd_pr "$@" ;;
    list|ls) cmd_list "$@" ;;
    status|st) cmd_status "$@" ;;
    reap|rm) cmd_reap "$@" ;;
    cd) cmd_cd "$@" ;;
    focus) cmd_focus "$@" ;;
    resume) cmd_resume "$@" ;;
    close-tab|close) cmd_close_tab "$@" ;;
    tidy) cmd_tidy "$@" ;;
    audit) cmd_audit "$@" ;;
    repair) cmd_repair "$@" ;;
    doctor) cmd_doctor "$@" ;;
    bootstrap) cmd_bootstrap "$@" ;;
    onboard) cmd_onboard "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    version) cmd_version "$@" ;;
    plugin) cmd_plugin "$@" ;;
    install-hooks) cmd_install_hooks "$@" ;;
    uninstall-hooks) cmd_uninstall_hooks "$@" ;;
    -h|--help|help) cmd_help ;;
    --version|-V) cmd_version ;;
    *) cmd_help; exit 10 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
