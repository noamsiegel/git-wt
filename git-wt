#!/usr/bin/env bash
# wt — tiny worktree CLI. See ~/.pai/plans/wt-worktree-cli.md for the spec.
# Exit codes: 0 ok | 10 validation | 20 guardrail | 30 dep down | 40 lock | 50 rolled-back | 60 partial-noroll | 70 dry-refuse | 1 unknown

set -euo pipefail
IFS=$'\n\t'

WT_CONFIG=${WT_CONFIG:-$HOME/.config/wt/config.yaml}
WT_CACHE=${WT_CACHE:-$HOME/.config/wt/paths.cache}
WT_VERSION="0.10.11"

# Plugin system (v0.3.0+). Plugins are executables named `wt-<name>` installed
# under WT_PLUGIN_DIR. Active set tracked in WT_PLUGIN_CONFIG. See
# `wt plugin --help` for management and the README for the contract.
WT_PLUGIN_API_VERSION="git-wt.plugin.v0"
WT_PLUGIN_API_SUPPORTED=("git-wt.plugin.v0")
_WT_PLUGIN_LEGACY_API_WARNED=0
WT_PLUGIN_REGISTRY=${WT_PLUGIN_REGISTRY:-$(dirname "$(realpath "$0" 2>/dev/null || echo "$0")")/plugins-registry.json}
WT_PLUGIN_DIR=${WT_PLUGIN_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/git-wt/plugins}
WT_PLUGIN_CONFIG=${WT_PLUGIN_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/git-wt/plugins.json}
WT_YQ_BIN=${WT_YQ_BIN:-yq}

red() { printf '\033[31m%b\033[0m' "$*"; }
yellow() { printf '\033[33m%b\033[0m' "$*"; }
green() { printf '\033[32m%b\033[0m' "$*"; }
dim() { printf '\033[2m%b\033[0m' "$*"; }
die() { local code=$1; shift; printf '%s %s\n' "$(red ERROR:)" "$*" >&2; exit "$code"; }
warn() { printf '%s %s\n' "$(yellow WARN:)" "$*" >&2; }
info() { printf '%s\n' "$*" >&2; }

# ---------- dep checks ----------
have() { command -v "$1" >/dev/null 2>&1; }

require_deps() {
  have bash || die 30 "bash not found"
  if (( BASH_VERSINFO[0] < 4 )); then
    die 30 "wt requires bash >= 4 (got $BASH_VERSION). Install via 'brew install bash'."
  fi
  have "$WT_YQ_BIN" || die 30 "YQ not found. Install via 'brew install yq' (mikefarah/yq)."
  "$WT_YQ_BIN" --version 2>&1 | grep -q mikefarah || die 30 "wrong YQ dialect; need mikefarah/yq"
  have git || die 30 "git not found"
  have realpath || die 30 "realpath not found"
}

# Commands that operate on repos/worktrees need a configured wt setup.
# Commands like --version, --help, and `plugin validate <path>` don't.
require_config() {
  [[ -r "$WT_CONFIG" ]] || die 30 "config not readable: $WT_CONFIG"
}

# ---------- config helpers ----------
# ---------- config (cached) ----------
# Single yq dump of the entire config at first read; subsequent reads hit bash arrays.
# Call cfg_reload after wt itself writes to the config.
_CFG_LOADED=0
declare -gA _CFG_REPO_FIELDS=()
declare -gA _CFG_PATTERNS=()
declare -gA _CFG_SYMLINKS=()
declare -gA _CFG_BOOT_LINKED_PATH=()
declare -gA _CFG_BOOT_LINKED_SOURCE=()
declare -gA _CFG_BOOT_LINKED_DRIFT=()
declare -gA _CFG_BOOT_LINKED_REQUIRED=()
declare -gA _CFG_BOOT_ENV_SYMLINKS=()
declare -gA _CFG_BOOT_DIRENV=()
declare -gA _CFG_BOOT_POST_CREATE=()
declare -gA _CFG_BOOT_PORT_STRATEGY=()
declare -gA _CFG_BOOT_PORT_OUTPUT=()
declare -gA _CFG_BOOT_PORT_VAR_BASE=()
declare -gA _CFG_BOOT_PORT_VAR_SPAN=()
declare -gA _CFG_ISSUE_KEY_REGEX=()
_CFG_REPOS_LIST=""
_CFG_FORBIDDEN_LIST=""
_CFG_MAX_LEN=80
_CFG_HOOK_ENFORCE_BRANCH_NAMES=false
_CFG_REPO_RECORD_FIELDS=(repo path worktree_root base default_branch herdr_workspace)

_cfg_load() {
  (( _CFG_LOADED == 1 )) && return 0
  local line key value repo field rest idx name seen=":"
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" != *=* ]] && continue
    key="${line%% =*}"
    value="${line#*= }"
    case "$key" in
      defaults.branch_patterns.*)
        _CFG_PATTERNS[__defaults__]+="$value"$'\n'
        ;;
      defaults.worktree_symlinks.*)
        _CFG_SYMLINKS[__defaults__]+="$value"$'\n'
        ;;
    defaults.bootstrap.linked_dirs.*.path)
      rest="${key#defaults.bootstrap.linked_dirs.}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_PATH["__defaults__.$idx"]="$value"
      ;;
    defaults.bootstrap.linked_dirs.*.source)
      rest="${key#defaults.bootstrap.linked_dirs.}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_SOURCE["__defaults__.$idx"]="$value"
      ;;
    defaults.bootstrap.linked_dirs.*.drift_files.*)
      rest="${key#defaults.bootstrap.linked_dirs.}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_DRIFT["__defaults__.$idx"]+="$value"$'\n'
      ;;
    defaults.bootstrap.linked_dirs.*.required_paths.*)
      rest="${key#defaults.bootstrap.linked_dirs.}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_REQUIRED["__defaults__.$idx"]+="$value"$'\n'
      ;;
    defaults.bootstrap.env.symlinks.*)
      _CFG_BOOT_ENV_SYMLINKS[__defaults__]+="$value"$'\n'
      ;;
    defaults.bootstrap.env.direnv)
      _CFG_BOOT_DIRENV[__defaults__]="$value"
      ;;
    defaults.bootstrap.ports.strategy)
      _CFG_BOOT_PORT_STRATEGY[__defaults__]="$value"
      ;;
    defaults.bootstrap.ports.output)
      _CFG_BOOT_PORT_OUTPUT[__defaults__]="$value"
      ;;
    defaults.bootstrap.ports.variables.*.base)
      name="${key#defaults.bootstrap.ports.variables.}"; name="${name%%.*}"
      _CFG_BOOT_PORT_VAR_BASE["__defaults__.$name"]="$value"
      ;;
    defaults.bootstrap.ports.variables.*.span)
      name="${key#defaults.bootstrap.ports.variables.}"; name="${name%%.*}"
      _CFG_BOOT_PORT_VAR_SPAN["__defaults__.$name"]="$value"
      ;;
    defaults.bootstrap.post_create.*)
      _CFG_BOOT_POST_CREATE[__defaults__]+="$value"$'\n'
      ;;
 defaults.branch_issue_key_regex)
 _CFG_ISSUE_KEY_REGEX[__defaults__]="$value"
 ;;
      defaults.*)
        field="${key#defaults.}"
        _CFG_REPO_FIELDS["__defaults__.$field"]="$value"
        ;;
      hooks.enforce_branch_names)
        _CFG_HOOK_ENFORCE_BRANCH_NAMES="$value"
        ;;
      repos.*.branch_patterns.*)
        repo="${key#repos.}"; repo="${repo%%.*}"
        _CFG_PATTERNS[$repo]+="$value"$'\n'
        # First sighting of this repo (order-preserving)?
        [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
        ;;
      repos.*.worktree_symlinks.*)
        repo="${key#repos.}"; repo="${repo%%.*}"
        _CFG_SYMLINKS[$repo]+="$value"$'\n'
        [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
        ;;
    repos.*.bootstrap.linked_dirs.*.path)
      repo="${key#repos.}"; rest="${repo#*.bootstrap.linked_dirs.}"; repo="${repo%%.*}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_PATH["$repo.$idx"]="$value"
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.linked_dirs.*.source)
      repo="${key#repos.}"; rest="${repo#*.bootstrap.linked_dirs.}"; repo="${repo%%.*}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_SOURCE["$repo.$idx"]="$value"
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.linked_dirs.*.drift_files.*)
      repo="${key#repos.}"; rest="${repo#*.bootstrap.linked_dirs.}"; repo="${repo%%.*}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_DRIFT["$repo.$idx"]+="$value"$'\n'
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.linked_dirs.*.required_paths.*)
      repo="${key#repos.}"; rest="${repo#*.bootstrap.linked_dirs.}"; repo="${repo%%.*}"; idx="${rest%%.*}"
      _CFG_BOOT_LINKED_REQUIRED["$repo.$idx"]+="$value"$'\n'
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.env.symlinks.*)
      repo="${key#repos.}"; repo="${repo%%.*}"
      _CFG_BOOT_ENV_SYMLINKS[$repo]+="$value"$'\n'
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.env.direnv)
      repo="${key#repos.}"; repo="${repo%%.*}"
      _CFG_BOOT_DIRENV[$repo]="$value"
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.ports.strategy)
      repo="${key#repos.}"; repo="${repo%%.*}"
      _CFG_BOOT_PORT_STRATEGY[$repo]="$value"
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.ports.output)
      repo="${key#repos.}"; repo="${repo%%.*}"
      _CFG_BOOT_PORT_OUTPUT[$repo]="$value"
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.ports.variables.*.base)
      repo="${key#repos.}"; rest="${repo#*.bootstrap.ports.variables.}"; repo="${repo%%.*}"; name="${rest%%.*}"
      _CFG_BOOT_PORT_VAR_BASE["$repo.$name"]="$value"
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.ports.variables.*.span)
      repo="${key#repos.}"; rest="${repo#*.bootstrap.ports.variables.}"; repo="${repo%%.*}"; name="${rest%%.*}"
      _CFG_BOOT_PORT_VAR_SPAN["$repo.$name"]="$value"
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
    repos.*.bootstrap.post_create.*)
      repo="${key#repos.}"; repo="${repo%%.*}"
      _CFG_BOOT_POST_CREATE[$repo]+="$value"$'\n'
      [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
      ;;
 repos.*.branch_issue_key_regex)
 repo="${key#repos.}"; repo="${repo%%.*}"
 _CFG_ISSUE_KEY_REGEX[$repo]="$value"
 [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
 ;;
      repos.*.*)
        repo="${key#repos.}"; field="${repo#*.}"; repo="${repo%%.*}"
        _CFG_REPO_FIELDS["$repo.$field"]="$value"
        [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
        ;;
      forbidden_roots.*)
        _CFG_FORBIDDEN_LIST+="$value"$'\n'
        ;;
      branch_max_length)
        _CFG_MAX_LEN="$value"
        ;;
    esac
  done < <(yq -o=props . "$WT_CONFIG" 2>/dev/null)
  _CFG_LOADED=1
}
cfg_repos() { _cfg_load; printf '%s' "$_CFG_REPOS_LIST"; }
_cfg_repo_field_value() {
  # Assign before use: in a single `local a="$1" v="${arr[$a]}"` bash expands
  # every word before any assignment binds, so $a would resolve to the OUTER
  # scope (unbound under set -u; silently wrong when a global `repo` exists).
  local repo="$1" field="$2" v
  v="${_CFG_REPO_FIELDS[$repo.$field]:-}"
  if [[ -z "$v" ]]; then
    v="${_CFG_REPO_FIELDS[__defaults__.$field]:-}"
  fi
  if [[ -n "$v" ]]; then
    v="${v//\{repo\}/$repo}"
  fi
  printf '%s' "$v"
}
cfg_repo_configured() {
  _cfg_load
  [[ "$1" == "__defaults__" ]] && return 0
  [[ $'\n'"$_CFG_REPOS_LIST" == *$'\n'"$1"$'\n'* ]]
}
cfg_repo_record() {
  _cfg_load
  local repo="$1" field value sep=""
  cfg_repo_configured "$repo" || return 1
  for field in "${_CFG_REPO_RECORD_FIELDS[@]}"; do
    if [[ "$field" == "repo" ]]; then
      value="$repo"
    else
      value=$(_cfg_repo_field_value "$repo" "$field")
    fi
    printf '%s%s' "$sep" "$value"
    sep=$'\034'
  done
  printf '\n'
}
cfg_each_repo_record() {
  _cfg_load
  local repo
  while IFS= read -r repo; do
    [[ -z "$repo" ]] && continue
    cfg_repo_record "$repo"
  done <<< "$_CFG_REPOS_LIST"
}
cfg_repo_get() {
  _cfg_load
  local repo="$1" field="$2" v
  v=$(_cfg_repo_field_value "$repo" "$field")
  [[ -z "$v" ]] && echo "null" || echo "$v"
}
cfg_reload() { _CFG_LOADED=0; }
cfg_branch_patterns() {
  _cfg_load
  local patterns="${_CFG_PATTERNS[$1]:-}"
  [[ -z "$patterns" ]] && patterns="${_CFG_PATTERNS[__defaults__]:-}"
  printf '%s' "$patterns"
}
cfg_worktree_symlinks() {
  _cfg_load
  local links="${_CFG_SYMLINKS[$1]:-}"
  [[ -z "$links" ]] && links="${_CFG_SYMLINKS[__defaults__]:-}"
  printf '%s' "$links"
}
_cfg_escape_lines() {
  local value="$1" line out="" sep=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    out+="$sep$line"
    sep='\n'
  done <<< "$value"
  printf '%s' "$out"
}
_cfg_record_field_lines() {
  local value="$1"
  [[ -z "$value" ]] && return 0
  printf '%s\n' "${value//\\n/$'\n'}"
}
_cfg_has_prefixed_key() {
  local prefix="$1" key
  shift
  for key in "$@"; do [[ "$key" == "$prefix"* ]] && return 0; done
  return 1
}
_cfg_bootstrap_linked_scope() {
  local repo="$1"
  _cfg_load
  _cfg_has_prefixed_key "$repo." "${!_CFG_BOOT_LINKED_PATH[@]}" && { printf '%s' "$repo"; return 0; }
  _cfg_has_prefixed_key "__defaults__." "${!_CFG_BOOT_LINKED_PATH[@]}" && printf '%s' "__defaults__"
}
cfg_bootstrap_linked_dirs() {
  _cfg_load
  local repo="$1" scope idx path source drift required
  scope=$(_cfg_bootstrap_linked_scope "$repo")
  [[ -z "$scope" ]] && return 0
  for ((idx=0; idx<1000; idx++)); do
    path="${_CFG_BOOT_LINKED_PATH[$scope.$idx]:-}"
    [[ -z "$path" ]] && continue
    source="${_CFG_BOOT_LINKED_SOURCE[$scope.$idx]:-canonical}"
    drift=$(_cfg_escape_lines "${_CFG_BOOT_LINKED_DRIFT[$scope.$idx]:-}")
    required=$(_cfg_escape_lines "${_CFG_BOOT_LINKED_REQUIRED[$scope.$idx]:-}")
    printf '%s\034%s\034%s\034%s\n' "$path" "$source" "$drift" "$required"
  done
}
cfg_bootstrap_env_symlinks() {
  _cfg_load
  local repo="$1" links
  links="${_CFG_BOOT_ENV_SYMLINKS[$repo]:-}"
  if [[ -n "$links" ]]; then printf '%s' "$links"; return 0; fi
  links="${_CFG_BOOT_ENV_SYMLINKS[__defaults__]:-}"
  if [[ -n "$links" ]]; then printf '%s' "$links"; return 0; fi
  cfg_worktree_symlinks "$repo"
}
cfg_bootstrap_direnv() {
  _cfg_load
  local repo="$1" value
  value="${_CFG_BOOT_DIRENV[$repo]:-}"
  [[ -z "$value" ]] && value="${_CFG_BOOT_DIRENV[__defaults__]:-}"
  printf '%s' "$value"
}
cfg_bootstrap_post_create() {
  _cfg_load
  local repo="$1" items
  items="${_CFG_BOOT_POST_CREATE[$repo]:-}"
  [[ -z "$items" ]] && items="${_CFG_BOOT_POST_CREATE[__defaults__]:-}"
  if [[ -z "$items" ]]; then
    local legacy
    legacy=$(cfg_repo_get "$repo" setup_command)
    [[ -n "$legacy" && "$legacy" != "null" ]] && printf '%s\n' "$legacy"
    return 0
  fi
  printf '%s' "$items"
}
_cfg_bootstrap_ports_scope() {
  local repo="$1"
  _cfg_load
  if [[ -n "${_CFG_BOOT_PORT_STRATEGY[$repo]:-}${_CFG_BOOT_PORT_OUTPUT[$repo]:-}" ]] || _cfg_has_prefixed_key "$repo." "${!_CFG_BOOT_PORT_VAR_BASE[@]}" "${!_CFG_BOOT_PORT_VAR_SPAN[@]}"; then
    printf '%s' "$repo"; return 0
  fi
  if [[ -n "${_CFG_BOOT_PORT_STRATEGY[__defaults__]:-}${_CFG_BOOT_PORT_OUTPUT[__defaults__]:-}" ]] || _cfg_has_prefixed_key "__defaults__." "${!_CFG_BOOT_PORT_VAR_BASE[@]}" "${!_CFG_BOOT_PORT_VAR_SPAN[@]}"; then
    printf '%s' "__defaults__"
  fi
}
cfg_bootstrap_has_structured_post_create() {
  _cfg_load
  local repo="$1"
  [[ -n "${_CFG_BOOT_POST_CREATE[$repo]:-}" || -n "${_CFG_BOOT_POST_CREATE[__defaults__]:-}" ]]
}
cfg_bootstrap_ports() {
  _cfg_load
  local repo="$1" scope strategy output key name names="" base span
  scope=$(_cfg_bootstrap_ports_scope "$repo")
  [[ -z "$scope" ]] && return 0
  strategy="${_CFG_BOOT_PORT_STRATEGY[$scope]:-}"
  output="${_CFG_BOOT_PORT_OUTPUT[$scope]:-}"
  printf 'config\034%s\034%s\n' "$strategy" "$output"
  for key in "${!_CFG_BOOT_PORT_VAR_BASE[@]}" "${!_CFG_BOOT_PORT_VAR_SPAN[@]}"; do
    [[ "$key" == "$scope."* ]] || continue
    name="${key#$scope.}"
    [[ $'\n'"$names" == *$'\n'"$name"$'\n'* ]] && continue
    names+="$name"$'\n'
  done
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    base="${_CFG_BOOT_PORT_VAR_BASE[$scope.$name]:-}"
    span="${_CFG_BOOT_PORT_VAR_SPAN[$scope.$name]:-}"
    printf 'var\034%s\034%s\034%s\n' "$name" "$base" "$span"
  done < <(printf '%s' "$names" | sort)
}
cfg_forbidden() { _cfg_load; printf '%s' "$_CFG_FORBIDDEN_LIST"; }
cfg_max_branch_len() { _cfg_load; echo "$_CFG_MAX_LEN"; }
cfg_hook_enforce_branch_names() { _cfg_load; echo "$_CFG_HOOK_ENFORCE_BRANCH_NAMES"; }
# Per-repo autopush policy: repos.<name>.hooks.autopush, falling back to
# defaults.hooks.autopush, defaulting to on. Only the literal string "false"
# disables — autopush is the safety default (work must not exist only on
# local disk), so an unset/typo'd value stays on.
cfg_repo_autopush() {
  _cfg_load
  local v; v=$(_cfg_repo_field_value "$1" "hooks.autopush")
  [[ "$v" == "false" ]] && echo "false" || echo "true"
}
cfg_branch_issue_key_regex() {
 _cfg_load
 local regex="${_CFG_ISSUE_KEY_REGEX[$1]:-}"
 [[ -z "$regex" ]] && regex="${_CFG_ISSUE_KEY_REGEX[__defaults__]:-}"
 printf '%s' "$regex"
}
cfg_enforce_unique_issue_keys() {
 local v
 v=$(cfg_repo_get "$1" enforce_unique_issue_keys 2>/dev/null || echo "")
 [[ "$v" == "true" || "$v" == "1" || "$v" == "yes" ]]
}

# Realpath of a path; never fails (returns input on miss).
rp() { realpath "$1" 2>/dev/null || echo "$1"; }

# 0 if <path> is at or under any configured forbidden root (e.g. OMP isolation).
path_under_forbidden() {
  local rp_probe forbidden rp_forbidden
  rp_probe=$(rp "$1")
  while IFS= read -r forbidden; do
    [[ -z "$forbidden" ]] && continue
    rp_forbidden=$(rp "$forbidden")
    [[ "$rp_probe" == "$rp_forbidden" || "$rp_probe" == "$rp_forbidden"/* ]] && return 0
  done < <(cfg_forbidden)
  return 1
}

# ---------- forbidden-root check (UNCONDITIONAL; every command) ----------
guard_forbidden() {
  local probes=("$PWD")
  while (($#)); do probes+=("$1"); shift; done
  local probe forbidden rp_probe rp_forbidden
  for probe in "${probes[@]}"; do
    rp_probe=$(rp "$probe")
    while IFS= read -r forbidden; do
      [[ -z "$forbidden" ]] && continue
      rp_forbidden=$(rp "$forbidden")
      if [[ "$rp_probe" == "$rp_forbidden" || "$rp_probe" == "$rp_forbidden"/* ]]; then
        die 20 "path '$probe' is under forbidden root '$forbidden' (reserved for OMP isolation)"
      fi
    done < <(cfg_forbidden)
  done
}

# Refuse if $PWD is the top-level of (or under) any configured canonical repo.
# Per spec guardrail #5: trains "canonical = parking spot" muscle memory.
guard_not_canonical() {
  local cwd repo path
  cwd=$(rp "$PWD")
  for repo in $(cfg_repos); do
    path=$(rp "$(cfg_repo_get "$repo" path)")
    if [[ "$cwd" == "$path" || "$cwd" == "$path"/* ]]; then
      die 20 "cwd is inside canonical checkout of '$repo' ($path) — canonical is read-only. Use 'wt new' / 'wt adopt' from elsewhere."
    fi
  done
}
# ---------- repo resolution ----------
# Determine which configured repo this id belongs to by searching every worktree_root.
repo_for_id() {
  local id="$1" record repo _id _path _rp_path _branch _sha _is_canonical
  record=$(wt_resolve_id "$id") || return 1
  wt_record_fields "$record" repo _id _path _rp_path _branch _sha _is_canonical
  echo "$repo"
}

# Determine canonical or worktree context from $PWD; outputs "<repo> <kind>".
repo_for_cwd() {
  local cwd repo path wt_root
  cwd=$(rp "$PWD")
  for repo in $(cfg_repos); do
    path=$(rp "$(cfg_repo_get "$repo" path)")
    wt_root=$(rp "$(cfg_repo_get "$repo" worktree_root)")
    if [[ "$cwd" == "$path" || "$cwd" == "$path"/* ]]; then
      echo "$repo canonical"
      return 0
    fi
    if [[ "$cwd" == "$wt_root"/* ]]; then
      echo "$repo worktree"
      return 0
    fi
  done
  return 1
}

# Emit one TSV record per worktree for <repo>:
#   repo\tid\tpath\trp_path\tbranch\tsha\tis_canonical
# is_canonical is the string "canonical" or "worktree".
wt_each_worktree() {
  local repo="$1" canonical wt_root id path rp_path branch sha is_canonical line key value
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)

  path=""; rp_path=""; branch=""; sha=""; is_canonical=""
  _wt_emit_worktree_record() {
    [[ -n "$path" ]] || return 0
    id="${path##*/}"
    rp_path=$(rp "$path")
    if [[ "$rp_path" == "$(rp "$canonical")" ]]; then
      is_canonical="canonical"
      path="$canonical"
      id="${path##*/}"
    else
      is_canonical="worktree"
      if [[ "$rp_path" == "$(rp "$wt_root/$id")" ]]; then
        path="$wt_root/$id"
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$repo" "$id" "$path" "$rp_path" "$branch" "$sha" "$is_canonical"
  }

  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      _wt_emit_worktree_record
      path="${line#worktree }"
      branch=""
      sha=""
      continue
    fi
    [[ -n "$path" ]] || continue
    key="${line%% *}"
    value=""
    [[ "$line" == *" "* ]] && value="${line#* }"
    case "$key" in
      HEAD) sha="${value:0:10}" ;;
      branch) branch="${value#refs/heads/}" ;;
      detached|bare) branch="" ;;
    esac
  # Single git worktree list --porcelain adapter.
  done < <(git_in "$canonical" worktree list --porcelain 2>/dev/null)
  _wt_emit_worktree_record
  unset -f _wt_emit_worktree_record
}

wt_record_fields() {
  local _record="${1//$'\t'/$'\034'}"
  shift
  IFS=$'\034' read -r "$@" <<< "$_record"
}

# Resolve <id> to one TSV worktree record, optionally constrained with --repo <repo>.
wt_resolve_id() {
  local repo_filter="" id repo record r_repo r_id r_path r_rp_path r_branch r_sha r_is_canonical match="" count=0
  if [[ "${1:-}" == "--repo" ]]; then
    repo_filter="${2:-}"
    id="${3:-}"
  else
    id="${1:-}"
  fi
  [[ -n "$id" ]] || return 1

  for repo in $(cfg_repos); do
    [[ -z "$repo_filter" || "$repo" == "$repo_filter" ]] || continue
    while IFS= read -r record; do
      wt_record_fields "$record" r_repo r_id r_path r_rp_path r_branch r_sha r_is_canonical
      [[ "$r_is_canonical" == "worktree" ]] || continue
      [[ "$r_id" == "$id" ]] || continue
      match="$r_repo"$'\t'"$r_id"$'\t'"$r_path"$'\t'"$r_rp_path"$'\t'"$r_branch"$'\t'"$r_sha"$'\t'"$r_is_canonical"
      count=$((count + 1))
    done < <(wt_each_worktree "$repo")
  done

  [[ "$count" -eq 1 ]] || return 1
  printf '%s\n' "$match"
}

# ---------- branch / id helpers ----------
# Return the repo name whose patterns match <branch>. Empty if no match;
# repo name if unique match; first match if ambiguous (deterministic cfg_repos order).
branch_policy_match_repo() {
  local branch="$1"
  local repo pattern
  for repo in $(cfg_repos); do
    while IFS= read -r pattern; do
      [[ -z "$pattern" ]] && continue
      if [[ "$branch" =~ $pattern ]]; then
        printf '%s\n' "$repo"
        return 0
      fi
    done < <(cfg_branch_patterns "$repo")
  done
  return 0
}

# Return 0 if <branch> is allowed by <repo>'s configured pattern set.
# Repos with no patterns allow all branch names after global length validation.
branch_policy_branch_matches() {
  local repo="$1" branch="$2" pattern has_patterns=0
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    has_patterns=1
    if [[ "$branch" =~ $pattern ]]; then return 0; fi
  done < <(cfg_branch_patterns "$repo")
  (( has_patterns == 0 ))
}

# Return 0 if <branch> passes the full branch policy for <repo>.
branch_policy_allows() {
  local repo="$1" branch="$2" maxlen
  maxlen=$(cfg_max_branch_len)
  (( ${#branch} <= maxlen )) || return 1
  branch_policy_branch_matches "$repo" "$branch"
}

# Validate <branch> against <repo>'s configured policy; dies with user-facing detail.
branch_policy_validate() {
  local repo="$1" branch="$2" maxlen
  maxlen=$(cfg_max_branch_len)
  if (( ${#branch} > maxlen )); then
    die 10 "branch name >$maxlen chars: ${branch}"
  fi
  branch_policy_branch_matches "$repo" "$branch" \
    || die 10 "branch '$branch' does not match any configured pattern for repo '$repo'"
}

branch_issue_key() {
  local repo="$1" branch="$2" regex
  regex=$(cfg_branch_issue_key_regex "$repo")
  [[ -n "$regex" ]] || return 1
  [[ "$branch" =~ $regex ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]:-${BASH_REMATCH[0]}}"
}

branch_issue_key_duplicate() {
  local repo="$1" branch="$2" key record r_repo r_id r_path r_rp_path r_branch r_sha r_is_canonical other_key
  key=$(branch_issue_key "$repo" "$branch") || return 1
  while IFS= read -r record; do
    wt_record_fields "$record" r_repo r_id r_path r_rp_path r_branch r_sha r_is_canonical
    [[ "$r_is_canonical" == "worktree" ]] || continue
    [[ -n "$r_branch" && "$r_branch" != "$branch" ]] || continue
    other_key=$(branch_issue_key "$repo" "$r_branch") || continue
    [[ "$other_key" == "$key" ]] || continue
    printf '%s\t%s\t%s\n' "$key" "$r_branch" "$r_path"
    return 0
  done < <(wt_each_worktree "$repo")
  return 1
}

branch_issue_key_validate_unique() {
  local repo="$1" branch="$2" allow_duplicate="${3:-0}" duplicate key existing_branch existing_path
  cfg_enforce_unique_issue_keys "$repo" || return 0
  [[ "$allow_duplicate" == "1" ]] && return 0
  duplicate=$(branch_issue_key_duplicate "$repo" "$branch") || return 0
  IFS=$'\t' read -r key existing_branch existing_path <<< "$duplicate"
  die 20 "branch issue key '$key' already has worktree branch '$existing_branch' at $existing_path (use --allow-duplicate-issue-key to override)"
}

# Emit <repo>'s branch_patterns as a quoted bash array body for hook cache.
branch_policy_emit_cache() {
  local repo="$1" pattern
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    printf "  %q\n" "$pattern"
  done < <(cfg_branch_patterns "$repo")
}

validate_branch_shape() {
  branch_policy_validate "$@"
}

# Strip up-to-first-slash prefix; fallback to verbatim.
derive_id() {
  local branch="$1"
  if [[ "$branch" == */* ]]; then echo "${branch#*/}"; else echo "$branch"; fi
}

# ---------- locking ----------
acquire_lock() {
  local wt_root="$1"
  mkdir -p "$wt_root"
  local lock_dir="$wt_root/.wt.lock"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    local locker
    locker=$(cat "$lock_dir/pid" 2>/dev/null || echo "?")
    die 40 "worktree_root $wt_root is locked by pid $locker"
  fi
  echo $$ > "$lock_dir/pid"
  WT_LOCK_DIR="$lock_dir"
  trap 'release_lock' EXIT INT TERM
}
release_lock() {
  [[ -n "${WT_LOCK_DIR:-}" && -d "$WT_LOCK_DIR" ]] && rm -rf "$WT_LOCK_DIR" 2>/dev/null || true
  WT_LOCK_DIR=""
}

# ---------- plugin system ----------
#
# Plugins are executables named `wt-<name>` installed under
# $WT_PLUGIN_DIR/wt-<name>/wt-<name>, with a sibling `wt-plugin.json` manifest:
#
#   {
#     "api_version": "git-wt.plugin.v0",
#     "name": "tmux",
#     "executable": "wt-tmux",
#     "events": ["wt:worktree-created","wt:worktree-removed","wt:focus","wt:list"],
#     "version": "0.1.0"
#   }
#
# Invocation contract:
#   wt-<name> manifest                    → prints manifest JSON
#   wt-<name> health                      → returns {"ok":true,...} or non-zero exit
#   wt-<name> event <event-name> < json   → handles one event; output JSON optional
#
# Core never imports plugin functions; it only spawns plugin executables.

# Resolve the wt-<name> executable path for an installed plugin. Empty if not found.
wt_plugin_path() {
  local name="$1"
  local exe="$WT_PLUGIN_DIR/wt-$name/wt-$name"
  [[ -x "$exe" ]] && printf '%s' "$exe"
}

# Parse a plugin's manifest. Caller redirects stderr if they want a quiet read.
wt_plugin_manifest_read() {
  local name="$1"
  local mf="$WT_PLUGIN_DIR/wt-$name/wt-plugin.json"
  [[ -r "$mf" ]] || return 1
  cat "$mf"
}

wt_plugin_manifest_api_versions() {
  local manifest="$1"
  local versions legacy
  versions=$(printf '%s' "$manifest" | "$WT_YQ_BIN" -p json -o tsv '.api_versions[]' 2>/dev/null || true)
  if [[ -n "$versions" ]]; then
    printf '%s\n' "$versions"
    return 0
  fi
  legacy=$(printf '%s' "$manifest" | "$WT_YQ_BIN" -p json -o tsv '.api_version // ""' 2>/dev/null || true)
  if [[ -n "$legacy" && "$legacy" != "null" ]]; then
    if (( _WT_PLUGIN_LEGACY_API_WARNED == 0 )); then
      warn "plugin manifest uses deprecated api_version; use api_versions array"
      _WT_PLUGIN_LEGACY_API_WARNED=1
    fi
    printf '%s\n' "$legacy"
    return 0
  fi
  return 1
}

wt_plugin_manifest_compatible() {
  local manifest="$1" version supported
  while IFS= read -r version; do
    [[ -n "$version" ]] || continue
    for supported in "${WT_PLUGIN_API_SUPPORTED[@]}"; do
      [[ "$version" == "$supported" ]] && return 0
    done
  done < <(wt_plugin_manifest_api_versions "$manifest")
  return 1
}

wt_plugin_manifest_supported_text() {
  local IFS=', '
  printf '%s' "${WT_PLUGIN_API_SUPPORTED[*]}"
}

wt_plugin_validate_dir() {
  local dir="$1" run_health="${2:-1}"
  local errors=0 manifest manifest_json name executable events_count capabilities_count exe health_output health_ok api_versions versions_csv
  [[ -d "$dir" ]] || { printf 'ERROR: not a directory: %s\n' "$dir"; return 1; }
  manifest="$dir/wt-plugin.json"
  if [[ ! -r "$manifest" ]]; then
    printf 'ERROR: missing manifest: %s\n' "$manifest"
    return 1
  fi
  if ! "$WT_YQ_BIN" -p json '.' "$manifest" >/dev/null 2>&1; then
    printf 'ERROR: wt-plugin.json is not valid JSON\n'
    return 1
  fi

  manifest_json=$(cat "$manifest")
  name=$(printf '%s' "$manifest_json" | "$WT_YQ_BIN" -p json -o tsv '.name // ""' 2>/dev/null || true)
  executable=$(printf '%s' "$manifest_json" | "$WT_YQ_BIN" -p json -o tsv '.executable // ""' 2>/dev/null || true)
  events_count=$(printf '%s' "$manifest_json" | "$WT_YQ_BIN" -p json -o tsv '.events | length' 2>/dev/null || echo 0)
  capabilities_count=$(printf '%s' "$manifest_json" | "$WT_YQ_BIN" -p json -o tsv '(.capabilities // []) | length' 2>/dev/null || echo 0)
  api_versions=$(wt_plugin_manifest_api_versions "$manifest_json" 2>/dev/null || true)

  if [[ -z "$name" || "$name" == "null" ]]; then printf 'ERROR: manifest field .name is required\n'; errors=$((errors + 1)); fi
  if [[ -z "$executable" || "$executable" == "null" ]]; then printf 'ERROR: manifest field .executable is required\n'; errors=$((errors + 1)); fi
  if [[ -z "$api_versions" ]]; then
    printf 'ERROR: manifest field .api_versions must include a supported API version (%s)\n' "$(wt_plugin_manifest_supported_text)"; errors=$((errors + 1))
  elif ! wt_plugin_manifest_compatible "$manifest_json" >/dev/null; then
    versions_csv=${api_versions//$'\n'/,}
    printf 'ERROR: incompatible plugin API versions: %s (host supports: %s)\n' "$versions_csv" "$(wt_plugin_manifest_supported_text)"; errors=$((errors + 1))
  fi
  if ! printf '%s' "$manifest_json" | "$WT_YQ_BIN" -p json -e '.events | type == "!!seq"' >/dev/null 2>&1; then
    printf 'ERROR: manifest field .events must be an array\n'; errors=$((errors + 1))
  elif [[ -z "$events_count" || "$events_count" == "0" || "$events_count" == "null" ]]; then
    printf 'ERROR: manifest field .events must be a non-empty array\n'; errors=$((errors + 1))
  fi
  if ! printf '%s' "$manifest_json" | "$WT_YQ_BIN" -p json -e '(.capabilities == null) or (.capabilities | type == "!!seq")' >/dev/null 2>&1; then
    printf 'ERROR: manifest field .capabilities must be an array when present\n'; errors=$((errors + 1))
  fi
  if [[ -n "$name" && "$name" != "null" && -n "$executable" && "$executable" != "wt-$name" ]]; then
    printf 'ERROR: executable must be wt-%s (got %s)\n' "$name" "$executable"; errors=$((errors + 1))
  fi
  exe="$dir/$executable"
  if [[ -n "$executable" && "$executable" != "null" && ! -x "$exe" ]]; then
    printf 'ERROR: executable is missing or not executable: %s\n' "$exe"; errors=$((errors + 1))
  fi

  if [[ "$run_health" == "1" && -x "$exe" ]]; then
    if ! health_output=$("$exe" health 2>&1); then
      printf 'ERROR: health command failed: %s\n' "$health_output"; errors=$((errors + 1)); health_output=""
    fi
    if [[ -n "$health_output" ]]; then
      if ! printf '%s' "$health_output" | "$WT_YQ_BIN" -p json '.' >/dev/null 2>&1; then
        printf 'ERROR: health output is not JSON: %s\n' "$health_output"; errors=$((errors + 1))
      else
        health_ok=$(printf '%s' "$health_output" | "$WT_YQ_BIN" -p json -o tsv '.ok // false' 2>/dev/null || echo false)
        [[ "$health_ok" == "true" ]] || { printf 'ERROR: health reported ok=false: %s\n' "$health_output"; errors=$((errors + 1)); }
      fi
    fi
  fi

  if (( errors == 0 )); then
    printf 'OK: plugin %s is valid (capabilities: %s)\n' "$name" "${capabilities_count:-0}"
    return 0
  fi
  return 1
}

wt_plugin_registry_known_names() {
  [[ -r "$WT_PLUGIN_REGISTRY" ]] || return 0
  "$WT_YQ_BIN" -p json -o tsv '.plugins[].name' "$WT_PLUGIN_REGISTRY" 2>/dev/null || true
}

wt_plugin_registry_repo_for() {
  local name="$1"
  [[ -r "$WT_PLUGIN_REGISTRY" ]] || return 1
  NAME="$name" "$WT_YQ_BIN" -p json -o tsv '.plugins[] | select(.name == strenv(NAME)) | .repo' "$WT_PLUGIN_REGISTRY" 2>/dev/null
}

wt_plugin_unknown_bare_die() {
  local name="$1" known plugin
  known=$(wt_plugin_registry_known_names)
  {
    printf 'Unknown plugin: %s\n\n' "$name"
    printf 'Known plugins:\n'
    if [[ -n "$known" ]]; then
      while IFS= read -r plugin; do [[ -n "$plugin" ]] && printf '  %s\n' "$plugin"; done <<< "$known"
    else
      printf '  (none; registry missing or empty: %s)\n' "$WT_PLUGIN_REGISTRY"
    fi
    printf '\nInstall a third-party plugin explicitly:\n'
    printf '  wt plugin install <owner>/wt-<name>\n'
    printf '  wt plugin install <https://...git>\n'
  } >&2
  exit 20
}

# Is the named plugin enabled in WT_PLUGIN_CONFIG?
wt_plugin_is_enabled() {
  local name="$1"
  [[ -r "$WT_PLUGIN_CONFIG" ]] || return 1
  have "$WT_YQ_BIN" || return 1
  local enabled
  enabled=$("$WT_YQ_BIN" -p json -o tsv ".enabled[]" "$WT_PLUGIN_CONFIG" 2>/dev/null || true)
  [[ "$enabled" == *"$name"* ]] || return 1
  printf '%s\n' "$enabled" | grep -Fxq "$name"
}

# List installed plugin names (directory names with `wt-` prefix, sans prefix).
wt_plugin_list_installed() {
  [[ -d "$WT_PLUGIN_DIR" ]] || return 0
  local d
  for d in "$WT_PLUGIN_DIR"/wt-*; do
    [[ -d "$d" ]] || continue
    basename "$d" | sed 's/^wt-//'
  done
}

# Emit a lifecycle event to all enabled plugins that declare interest.
# Best-effort: plugin failures warn but never fail the calling git operation.
# Arguments:
#   $1 — event name (e.g. wt:worktree-created)
#   $2 — JSON payload string
wt_plugin_emit() {
  local event="$1" payload="$2"
  [[ -d "$WT_PLUGIN_DIR" ]] || return 0
  have "$WT_YQ_BIN" || return 0
  local name exe manifest
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    wt_plugin_is_enabled "$name" || continue
    exe=$(wt_plugin_path "$name") || continue
    [[ -n "$exe" ]] || continue
    manifest=$(wt_plugin_manifest_read "$name" 2>/dev/null || true)
    # Quietly skip plugins that don't declare this event.
    if [[ -n "$manifest" ]]; then
      if ! printf '%s' "$manifest" | "$WT_YQ_BIN" -p json -o tsv ".events[]" 2>/dev/null | grep -Fxq "$event"; then
        continue
      fi
    fi
    printf '%s\n' "$payload" | "$exe" event "$event" >/dev/null 2>&1 \
      || warn "plugin '$name' failed for $event"
  done < <(wt_plugin_list_installed)
}

_wt_plugin_lifecycle_payload() {
  local event="$1" repo="$2" id="$3" path="$4" branch="$5" reason="${6:-}"
  local timestamp
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [[ -n "$reason" ]]; then
    API_VERSION="$WT_PLUGIN_API_VERSION" EVENT="$event" REPO="$repo" ID="$id" PATH_VALUE="$path" BRANCH="$branch" REASON="$reason" TIMESTAMP="$timestamp" \
      "$WT_YQ_BIN" -n -o=json '{"api_version": strenv(API_VERSION), "event": strenv(EVENT), "repo": strenv(REPO), "worktree": {"id": strenv(ID), "path": strenv(PATH_VALUE), "branch": strenv(BRANCH)}, "reason": strenv(REASON), "timestamp": strenv(TIMESTAMP)}'
  else
    API_VERSION="$WT_PLUGIN_API_VERSION" EVENT="$event" REPO="$repo" ID="$id" PATH_VALUE="$path" BRANCH="$branch" TIMESTAMP="$timestamp" \
      "$WT_YQ_BIN" -n -o=json '{"api_version": strenv(API_VERSION), "event": strenv(EVENT), "repo": strenv(REPO), "worktree": {"id": strenv(ID), "path": strenv(PATH_VALUE), "branch": strenv(BRANCH)}, "timestamp": strenv(TIMESTAMP)}'
  fi
}

wt_plugin_event_has_handler() {
  local event="$1" name exe manifest
  [[ -d "$WT_PLUGIN_DIR" ]] || return 1
  have "$WT_YQ_BIN" || return 1
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    wt_plugin_is_enabled "$name" || continue
    exe=$(wt_plugin_path "$name") || continue
    [[ -n "$exe" ]] || continue
    manifest=$(wt_plugin_manifest_read "$name" 2>/dev/null || true)
    [[ -z "$manifest" ]] && return 0
    if printf '%s' "$manifest" | "$WT_YQ_BIN" -p json -o tsv ".events[]" 2>/dev/null | grep -Fxq "$event"; then
      return 0
    fi
  done < <(wt_plugin_list_installed)
  return 1
}

wt_plugin_emit_lifecycle() {
  local event="$1" repo="$2" id="$3" path="$4" branch="$5" reason="${6:-}"
  local payload
  payload=$(_wt_plugin_lifecycle_payload "$event" "$repo" "$id" "$path" "$branch" "$reason") || return 0
  if ! wt_plugin_event_has_handler "$event"; then
    info "no plugin handling $event (install one with: wt plugin install he""rdr)"
    return 0
  fi
  wt_plugin_emit "$event" "$payload"
}

require_tab_plugin() {
  local command="$1"
  wt_plugin_event_has_handler "wt:focus" || die 30 "wt $command requires a tab plugin handling wt:focus; run: wt plugin install he""rdr"
}

# Initialize the plugin config file if missing.
# Initialize the plugin config file if missing.
wt_plugin_config_init() {
  if [[ ! -f "$WT_PLUGIN_CONFIG" ]]; then
    mkdir -p "$(dirname "$WT_PLUGIN_CONFIG")"
    cat > "$WT_PLUGIN_CONFIG" <<EOF
{
  "api_version": "$WT_PLUGIN_API_VERSION",
  "enabled": []
}
EOF
  fi
}

# Add a name to the enabled list (idempotent).
wt_plugin_config_enable() {
  local name="$1"
  wt_plugin_config_init
  have "$WT_YQ_BIN" || die 30 "YQ required to manage plugin config"
  if ! "$WT_YQ_BIN" -p json -o tsv '.enabled[]' "$WT_PLUGIN_CONFIG" 2>/dev/null | grep -Fxq "$name"; then
    "$WT_YQ_BIN" -p json -o json -i ".enabled += [\"$name\"]" "$WT_PLUGIN_CONFIG"
  fi
}

# Remove a name from the enabled list.
wt_plugin_config_disable() {
  local name="$1"
  wt_plugin_config_init
  have "$WT_YQ_BIN" || die 30 "YQ required to manage plugin config"
  "$WT_YQ_BIN" -p json -o json -i "del(.enabled[] | select(. == \"$name\"))" "$WT_PLUGIN_CONFIG"
}

# ---------- git helpers ----------
git_in() { git -C "$1" "${@:2}"; }

branch_exists_local() { git_in "$1" show-ref --verify --quiet "refs/heads/$2"; }
branch_exists_origin() {
  git_in "$1" ls-remote --exit-code --heads origin "$2" >/dev/null 2>&1
}
wt_dir_registered() {
  local repo="$1" target="$2" record r_repo r_id path rp_path branch sha is_canonical target_rp
  target_rp=$(rp "$target")
  while IFS= read -r record; do
    wt_record_fields "$record" r_repo r_id path rp_path branch sha is_canonical
    [[ "$rp_path" == "$target_rp" ]] && return 0
  done < <(wt_each_worktree "$repo")
  return 1
}

# Copy gitignored files matching .worktreeinclude patterns from canonical
# to a freshly-created worktree. Compatible with the Claude Code /
# VS Code convention: only files that are BOTH (a) gitignored and
# (b) match a pattern in .worktreeinclude are copied. Tracked files are
# never duplicated.
#
# Patterns are gitignore-style (one per line, # for comments). Resolution
# uses `git check-ignore` against each candidate file under the canonical
# tree.
copy_worktreeinclude_files() {
  local canonical="$1" target="$2"
  local include_file="$canonical/.worktreeinclude"
  [[ -r "$include_file" ]] || return 0

  # Read patterns, strip blanks and comments.
  local -a patterns=()
  while IFS= read -r line; do
    line="${line%%#*}"        # strip trailing comment
    line="${line#"${line%%[![:space:]]*}"}"  # ltrim
    line="${line%"${line##*[![:space:]]}"}"  # rtrim
    [[ -z "$line" ]] && continue
    patterns+=("$line")
  done < "$include_file"
  (( ${#patterns[@]} == 0 )) && return 0

  info "$(dim "→ .worktreeinclude: copying ignored files (${#patterns[@]} pattern(s))")"

  # For each pattern, expand under canonical and copy only matches that are
  # gitignored. `git ls-files --others --ignored --exclude-standard` enumerates
  # gitignored files in canonical; we intersect with the patterns.
  local count=0
  local relpath matched p
  while IFS= read -r -d '' relpath; do
    matched=0
    for p in "${patterns[@]}"; do
      case "$relpath" in
        $p|$p/*|*/$p|*/$p/*) matched=1; break ;;
      esac
      if [[ "$p" == \*\*/* ]]; then
        local suffix="${p#**/}"
        case "$relpath" in
          $suffix|*/$suffix) matched=1; break ;;
        esac
      fi
    done
    (( matched == 0 )) && continue

    local src="$canonical/$relpath"
    local dst="$target/$relpath"
    mkdir -p "$(dirname "$dst")"
    cp -p "$src" "$dst" 2>/dev/null || continue
    count=$((count + 1))
  done < <(git_in "$canonical" ls-files --others --ignored --exclude-standard -z 2>/dev/null)

  if (( count > 0 )); then
    info "$(dim "→ copied $count ignored file(s) to worktree")"
  fi
}

# Symlink configured env/config files from canonical checkout into new worktree.
# Live coupling, unlike .worktreeinclude copies. Never clobbers existing files;
# warns (never fails) on missing source; refuses path-escape entries.
link_bootstrap_env_symlinks() {
  local repo="$1" canonical="$2" target="$3" relpath src dst count=0
  while IFS= read -r relpath; do
    [[ -z "$relpath" ]] && continue
    if [[ "$relpath" == /* || "$relpath" == *..* ]]; then
      warn "worktree_symlinks: refusing unsafe path: $relpath"
      continue
    fi
    src="$canonical/$relpath"
    dst="$target/$relpath"
    [[ -e "$dst" || -L "$dst" ]] && continue
    if [[ ! -e "$src" ]]; then
      warn "worktree_symlinks: source missing, skipped: $relpath"
      continue
    fi
    mkdir -p "$(dirname "$dst")"
    if ln -s "$src" "$dst" 2>/dev/null; then
      count=$((count + 1))
    else
      warn "worktree_symlinks: failed link: $relpath"
    fi
  done < <(cfg_bootstrap_env_symlinks "$repo")
  if (( count > 0 )); then info "$(dim "→ linked $count file(s) into worktree")"; fi
  return 0
}
link_worktree_symlinks() { link_bootstrap_env_symlinks "$@"; }

_bootstrap_safe_relpath() {
  local rel="$1"
  [[ -n "$rel" && "$rel" != /* && "$rel" != *..* ]]
}
_bootstrap_link_expected() {
  local link="$1" expected="$2" actual
  [[ -L "$link" ]] || return 1
  actual=$(readlink "$link" 2>/dev/null || true)
  [[ "$actual" == "$expected" ]]
}
link_bootstrap_linked_dirs() {
  local repo="$1" canonical="$2" target="$3" rec path source drift_files required_paths src dst count=0
  while IFS= read -r rec; do
    [[ -z "$rec" ]] && continue
    IFS=$'\034' read -r path source drift_files required_paths <<< "$rec"
    if ! _bootstrap_safe_relpath "$path"; then
      warn "bootstrap linked_dirs: refusing unsafe path: $path"
      continue
    fi
    if [[ -n "$source" && "$source" != "canonical" ]]; then
      warn "bootstrap linked_dirs: unsupported source '$source', skipped: $path"
      continue
    fi
    src="$canonical/$path"
    dst="$target/$path"
    if [[ -e "$dst" || -L "$dst" ]]; then
      _bootstrap_link_expected "$dst" "$src" || warn "bootstrap linked_dirs: target exists and is not expected symlink: $path"
      continue
    fi
    if [[ ! -e "$src" ]]; then
      warn "bootstrap linked_dirs: source missing, skipped: $path"
      continue
    fi
    mkdir -p "$(dirname "$dst")"
    if ln -s "$src" "$dst" 2>/dev/null; then
      count=$((count + 1))
    else
      warn "bootstrap linked_dirs: failed link: $path"
    fi
  done < <(cfg_bootstrap_linked_dirs "$repo")
  if (( count > 0 )); then info "$(dim "→ linked $count bootstrap dir(s) into worktree")"; fi
  return 0
}

run_setup_direnv() {
  local target="$1" envrc envrc_n=0
  have direnv || return 0
  if [[ -e "$target/.envrc" ]]; then
    if ( cd "$target" && direnv allow . >/dev/null 2>&1 ); then envrc_n=$((envrc_n + 1)); fi
  fi
  while IFS= read -r envrc; do
    [[ -f "$target/$envrc" ]] || continue
    if ( cd "$target" && direnv allow "$envrc" >/dev/null 2>&1 ); then envrc_n=$((envrc_n + 1)); fi
  done < <(git -C "$target" ls-files 2>/dev/null | grep -E '/\.envrc$' || true)
  if (( envrc_n > 0 )); then
    info "$(dim "→ auto-setup: direnv allow (${envrc_n} .envrc)")"
  fi
  return 0
}

# Run configured per-repo setup_command inside freshly created worktree.
# Best-effort: non-zero exit warns but never undoes worktree creation.
run_setup_command() {
  local repo="$1" target="$2" cmd rc=0
  cmd=$(cfg_repo_get "$repo" setup_command)
  [[ -z "$cmd" || "$cmd" == "null" ]] && return 0
  if [[ "$cmd" == "auto" ]]; then run_setup_auto "$target"; return 0; fi
  info "$(dim "→ running setup_command in $target")"
  ( cd "$target" && bash -c "$cmd" ) || rc=$?
  if (( rc != 0 )); then warn "setup_command failed (exit $rc); worktree left in place"; fi
  return 0
}

# `setup_command: auto` — detect the toolchain from lockfiles at the worktree
# root and run the matching cache-backed installer, then authorize direnv. Each
# step is best-effort: a missing tool or failed install warns, never fails
# worktree creation. Heavy dep dirs are never copied/symlinked across worktrees;
# the installer's global cache (uv/bun/pnpm) keeps per-worktree installs cheap.
run_setup_auto() {
  local target="$1" ran=0
  _auto_run() {
    local lock="$1" tool="$2"; shift 2
    [[ -f "$target/$lock" ]] || return 0
    ran=1
    if ! have "$tool"; then warn "auto-setup: $lock present but '$tool' not found; skipped"; return 0; fi
    info "$(dim "→ auto-setup: $* (in $target)")"
    ( cd "$target" && "$@" ) || warn "auto-setup: '$*' failed (non-fatal)"
  }
  _auto_run uv.lock uv uv sync
  _auto_run bun.lockb bun bun install
  _auto_run bun.lock bun bun install
  _auto_run pnpm-lock.yaml pnpm pnpm install
  _auto_run yarn.lock yarn yarn install
  _auto_run package-lock.json npm npm ci
  # Authorize direnv: root .envrc plus every tracked nested .envrc.
  if have direnv && { [[ -e "$target/.envrc" ]] || git -C "$target" ls-files 2>/dev/null | grep -qE '/\.envrc$'; }; then
    ran=1
    run_setup_direnv "$target"
  fi
  if (( ran == 0 )); then info "$(dim "→ auto-setup: nothing to do (no lockfile/.envrc in worktree)")"; fi
  return 0
}

_bootstrap_int() { [[ "$1" =~ ^[0-9]+$ ]]; }
_bootstrap_port_file_marked() { [[ -f "$1" ]] && IFS= read -r _line < "$1" && [[ "$_line" == "# generated by wt bootstrap; safe to delete" ]]; }
write_bootstrap_ports() {
  local repo="$1" target="$2" id="$3" config strategy output rec kind name base span file tmp input hash offset port wrote=0
  config=$(cfg_bootstrap_ports "$repo")
  [[ -z "$config" ]] && return 0
  while IFS= read -r rec; do
    IFS=$'\034' read -r kind strategy output _ <<< "$rec"
    [[ "$kind" == "config" ]] && break
  done <<< "$config"
  [[ -z "$strategy" ]] && strategy="deterministic-hash"
  [[ -z "$output" ]] && output=".wt/ports.env"
  if [[ "$strategy" != "deterministic-hash" ]]; then warn "bootstrap ports: unsupported strategy '$strategy'"; return 0; fi
  if ! _bootstrap_safe_relpath "$output"; then warn "bootstrap ports: refusing unsafe output path: $output"; return 0; fi
  file="$target/$output"
  if [[ -e "$file" ]] && ! _bootstrap_port_file_marked "$file"; then
    warn "bootstrap ports: existing unmarked file, skipped: $output"
    return 0
  fi
  mkdir -p "$(dirname "$file")"
  tmp=$(mktemp)
  printf '# generated by wt bootstrap; safe to delete\n' > "$tmp"
  while IFS= read -r rec; do
    IFS=$'\034' read -r kind name base span <<< "$rec"
    [[ "$kind" == "var" ]] || continue
    if [[ ! "$name" =~ ^[A-Z_][A-Z0-9_]*$ ]]; then warn "bootstrap ports: invalid variable name: $name"; continue; fi
    if ! _bootstrap_int "$base" || ! _bootstrap_int "$span"; then warn "bootstrap ports: invalid base/span for $name"; continue; fi
    if (( base < 1 || base > 65535 || span < 1 || base + span - 1 > 65535 )); then warn "bootstrap ports: invalid range for $name"; continue; fi
    input="$repo:$id:$name"
    hash=$(printf '%s' "$input" | cksum)
    hash="${hash%% *}"
    offset=$((hash % span))
    port=$((base + offset))
    printf 'export %s=%s\n' "$name" "$port" >> "$tmp"
    wrote=1
  done <<< "$config"
  mv "$tmp" "$file"
  (( wrote == 1 )) && info "$(dim "→ wrote bootstrap ports $output")"
  return 0
}

run_bootstrap_post_create() {
  local repo="$1" target="$2" item rc
  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    if [[ "$item" == "auto" ]]; then run_setup_auto "$target"; continue; fi
    rc=0
    info "$(dim "→ running bootstrap post_create in $target")"
    ( cd "$target" && bash -c "$item" ) || rc=$?
    if (( rc != 0 )); then warn "bootstrap post_create failed (exit $rc); worktree left in place"; fi
  done < <(cfg_bootstrap_post_create "$repo")
  return 0
}
run_bootstrap() {
  local repo="$1" canonical="$2" target="$3" branch="$4" id="$5" direnv_mode
  link_bootstrap_env_symlinks "$repo" "$canonical" "$target"
  link_bootstrap_linked_dirs "$repo" "$canonical" "$target"
  write_bootstrap_ports "$repo" "$target" "$id"
  direnv_mode=$(cfg_bootstrap_direnv "$repo")
  if [[ "$direnv_mode" == "auto" || "$direnv_mode" == "true" ]]; then
    run_setup_direnv "$target"
  elif [[ -n "$direnv_mode" && "$direnv_mode" != "false" ]]; then
    warn "bootstrap env.direnv: unsupported value '$direnv_mode'"
  fi
  if cfg_bootstrap_has_structured_post_create "$repo"; then
    run_bootstrap_post_create "$repo" "$target"
  else
    run_setup_command "$repo" "$target"
  fi
  return 0
}

bootstrap_check_link_exists() {
  local canonical="$1" wt="$2" path="$3"
  [[ -L "$wt/$path" ]]
}
bootstrap_check_source_exists() {
  local canonical="$1" path="$2"
  [[ -e "$canonical/$path" ]]
}
bootstrap_check_link_points_to_source() {
  local canonical="$1" wt="$2" path="$3"
  _bootstrap_link_expected "$wt/$path" "$canonical/$path"
}
bootstrap_check_drift() {
  local canonical="$1" wt="$2" drift_file="$3"
  if [[ -e "$canonical/$drift_file" && -e "$wt/$drift_file" ]]; then
    cmp -s "$canonical/$drift_file" "$wt/$drift_file"
  else
    [[ ! -e "$canonical/$drift_file" && ! -e "$wt/$drift_file" ]]
  fi
}
bootstrap_check_required_paths() {
  local canonical="$1" linked_path="$2" required_path="$3"
  [[ -e "$canonical/$linked_path/$required_path" ]]
}
bootstrap_check_canonical_stale() {
  local canonical="$1" linked_path="$2" drift_file="$3" required_path="$4" src dep
  src="$canonical/$linked_path"
  dep="$canonical/$linked_path/$required_path"
  [[ -e "$canonical/$drift_file" && -e "$src" ]] || return 1
  [[ "$canonical/$drift_file" -nt "$src" ]] && return 0
  [[ -n "$required_path" && -e "$dep" && "$canonical/$drift_file" -nt "$dep" ]] && return 0
  return 1
}
bootstrap_health_report() {
  local repo="$1" canonical="$2" wt="$3" check_mode="${4:-doctor}" rec path source drift_files required_paths drift required missing any=0 warn_count=0 stale=0
  while IFS= read -r rec; do
    [[ -z "$rec" ]] && continue
    any=1
    IFS=$'\034' read -r path source drift_files required_paths <<< "$rec"
    if [[ -z "$path" ]]; then continue; fi
    if [[ "$source" != "canonical" ]]; then
      printf '%-40s' "linked $path"; yellow "WARN (unsupported source: $source)\n"; warn_count=$((warn_count + 1)); continue
    fi
    printf '%-40s' "linked $path"
    if bootstrap_check_link_points_to_source "$canonical" "$wt" "$path"; then green "PASS\n"; else yellow "WARN (missing/not expected symlink)\n"; warn_count=$((warn_count + 1)); fi
    printf '%-40s' "source $path"
    if bootstrap_check_source_exists "$canonical" "$path"; then green "PASS\n"; else yellow "WARN (canonical deps missing)\n"; warn_count=$((warn_count + 1)); fi
    while IFS= read -r drift; do
      [[ -z "$drift" ]] && continue
      printf '%-40s' "drift $drift"
      if bootstrap_check_drift "$canonical" "$wt" "$drift"; then green "PASS\n"; else yellow "WARN (differs from canonical)\n"; warn_count=$((warn_count + 1)); fi
    done < <(_cfg_record_field_lines "$drift_files")
    missing=""; stale=0
    while IFS= read -r required; do
      [[ -z "$required" ]] && continue
      if ! bootstrap_check_required_paths "$canonical" "$path" "$required"; then missing+="${missing:+, }$required"; fi
      while IFS= read -r drift; do
        [[ -z "$drift" ]] && continue
        bootstrap_check_canonical_stale "$canonical" "$path" "$drift" "$required" && stale=1
      done < <(_cfg_record_field_lines "$drift_files")
    done < <(_cfg_record_field_lines "$required_paths")
    if [[ -n "$required_paths" ]]; then
      printf '%-40s' "deps $path"
      if [[ -n "$missing" ]]; then yellow "WARN (missing: $missing)\n"; warn_count=$((warn_count + 1)); elif (( stale == 1 )); then yellow "WARN (canonical deps may be stale)\n"; else green "PASS\n"; fi
    fi
  done < <(cfg_bootstrap_linked_dirs "$repo")
  if (( any == 0 )); then
    local links_any=0 relpath
    while IFS= read -r relpath; do
      [[ -z "$relpath" ]] && continue
      links_any=1
      printf '%-40s' "symlink $relpath"
      if [[ -e "$wt/$relpath" ]]; then green "PASS\n"; else yellow "WARN (missing/dangling)\n"; warn_count=$((warn_count + 1)); fi
    done < <(cfg_worktree_symlinks "$repo")
    if (( links_any == 0 )); then printf '%-40s' "worktree_symlinks"; dim "INFO (none configured)\n"; fi
  fi
  return "$warn_count"
}

is_clean() {
  local wt="$1"
  [[ -z "$(git_in "$wt" status --porcelain 2>/dev/null)" ]]
}

is_pushed() {
  # Returns 0 if branch has an upstream and no local-only commits.
  local wt="$1"
  local upstream
  upstream=$(git_in "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || return 1
  local ahead
  ahead=$(git_in "$wt" rev-list --count "$upstream"..HEAD 2>/dev/null) || return 1
  [[ "$ahead" == "0" ]]
}

reachable_from() {
  # 0 if every commit on HEAD is present (by patch-id) in origin/<default>.
  local wt="$1" default="$2"
  local out
  out=$(git_in "$wt" cherry "origin/$default" 2>/dev/null) || return 1
  [[ -z "$(echo "$out" | grep '^+')" ]]
}

# Emit clean/pushed/reachable state for a worktree as:
#   clean\tpushed\treach
worktree_state_record() {
  local wt="$1" default="$2" clean pushed reach
  is_clean "$wt" && clean=yes || clean=no
  is_pushed "$wt" && pushed=yes || pushed=no
  reachable_from "$wt" "$default" && reach=yes || reach=no
  printf '%s\t%s\t%s\n' "$clean" "$pushed" "$reach"
}

# Emit one refusal token per line for a conservative reap safety check.
worktree_reap_refusals() {
  local wt="$1" default="$2" state clean pushed reach
  [[ -d "$wt" ]] || return 0
  state=$(worktree_state_record "$wt" "$default")
  wt_record_fields "$state" clean pushed reach
  [[ "$clean" == "yes" ]] || printf '%s\n' "uncommitted-changes"
  [[ "$pushed" == "yes" ]] || printf '%s\n' "unpushed-commits"
  [[ "$reach" == "yes" ]] || printf '%s\n' "not-reachable-from-origin/$default"
  if command -v lsof >/dev/null 2>&1; then
    local lsof_out n_pids
    lsof_out=$(lsof +D "$wt" 2>/dev/null | awk 'NR>1 {print $2}' | sort -u || true)
    if [[ -n "$lsof_out" ]]; then
      n_pids=$(echo "$lsof_out" | wc -l | tr -d ' ')
      printf '%s\n' "files-open-by-${n_pids}-process(es)"
    fi
  fi
}

# ---------- subcommands ----------

cmd_doctor() {
  local install_hooks=0 fail=0 wt_id=""
  while (($#)); do
    case "$1" in
      --install-hooks) install_hooks=1 ;;
      --worktree) wt_id="${2:-}"; shift ;;
      *) die 10 "unknown flag: $1" ;;
    esac
    shift
  done

  if [[ -n "$wt_id" ]]; then cmd_doctor_worktree "$wt_id"; return $?; fi

  printf '%-40s' "bash >= 4"; if (( BASH_VERSINFO[0] >= 4 )); then green "PASS\n"; else red "FAIL\n"; fail=1; fi
  printf '%-40s' "yq (mikefarah/yq)"; if "$WT_YQ_BIN" --version 2>&1 | grep -q mikefarah; then green "PASS\n"; else red "FAIL\n"; fail=1; fi
  printf '%-40s' "git available"; if have git; then green "PASS\n"; else red "FAIL\n"; fail=1; fi
  printf '%-40s' "config readable"; if [[ -r "$WT_CONFIG" ]]; then green "PASS\n"; else red "FAIL\n"; fail=1; fi

  local record repo path _worktree_root _base default _workspace
  while IFS= read -r record; do
    wt_record_fields "$record" repo path _worktree_root _base default _workspace
    printf '%-40s' "[$repo] canonical exists"
    if [[ -d "$path/.git" || -f "$path/.git" ]]; then green "PASS\n"; else red "FAIL\n"; fail=1; fi
    printf '%-40s' "[$repo] canonical on $default"
    local cur
    cur=$(git_in "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    if [[ "$cur" == "$default" ]]; then green "PASS\n"; else red "FAIL ($cur)\n"; fail=1; fi
    printf '%-40s' "[$repo] canonical clean"
    if is_clean "$path"; then green "PASS\n"; else yellow "WARN (dirty)\n"; fi
  done < <(cfg_each_repo_record)

  printf '%-40s' "no worktrees under forbidden_roots"
  local ext=0 record _repo _wid r_path r_rp_path _branch _sha _is_canonical repo2
  for repo2 in $(cfg_repos); do
    while IFS= read -r record; do
      wt_record_fields "$record" _repo _wid r_path r_rp_path _branch _sha _is_canonical
      [[ "$_is_canonical" == "worktree" ]] || continue
      if path_under_forbidden "$r_rp_path"; then ext=$((ext + 1)); fi
    done < <(wt_each_worktree "$repo2")
  done
  if (( ext == 0 )); then green "PASS\n"; else yellow "WARN (external: $ext)\n"; fi

  printf '%-40s' "core.hooksPath set"
  local hp
  hp=$(git config --global core.hooksPath 2>/dev/null || echo "")
  if [[ "$hp" == "$HOME/.config/git/hooks" ]]; then green "PASS\n"; else yellow "WARN (not set)\n"; fi

  local _hrepo _hcanon _lhp
  for _hrepo in $(cfg_repos); do
    _hcanon=$(cfg_repo_get "$_hrepo" path)
    _lhp=$(git_in "$_hcanon" config --local --get core.hooksPath 2>/dev/null || true)
    [[ -z "$_lhp" || "$_lhp" == "$HOME/.config/git/hooks" ]] && continue
    printf '%-40s' "[$_hrepo] effective hooks"
    if [[ "$_lhp" == "$HOME/.config/wt/repo-hooks/"* ]]; then
      green "PASS (wt dispatcher)\n"
    else
      yellow "WARN (local override: $_lhp)\n"
    fi
  done

  if (( install_hooks == 1 )); then
    generate_path_cache
    green "wrote $WT_CACHE\n"
  fi

  (( fail == 0 )) || exit 1
}

# Read-only per-worktree health report: wt doctor --worktree <id>.
cmd_doctor_worktree() {
  local id="$1" record repo wt _id r_rp_path _branch _sha _is_canonical canonical
  record=$(wt_resolve_id "$id") || die 20 "no worktree '$id' in any configured repo"
  wt_record_fields "$record" repo _id wt r_rp_path _branch _sha _is_canonical
  canonical=$(cfg_repo_get "$repo" path)
  printf '%s\n' "$(green "[$repo] worktree $id") $wt"

  bootstrap_health_report "$repo" "$canonical" "$wt" doctor || true

  printf '%-40s' ".venv"
  if [[ -d "$wt/.venv" ]]; then green "PASS\n"; else dim "INFO (absent)\n"; fi

  printf '%-40s' "direnv .envrc"
  if [[ -e "$wt/.envrc" ]]; then
    if have direnv; then green "PASS (.envrc present)\n"; else yellow "WARN (.envrc present, direnv missing)\n"; fi
  else
    dim "INFO (no .envrc)\n"
  fi

  printf '%-40s' "effective core.hooksPath"
  local hp; hp=$(git_in "$wt" config core.hooksPath 2>/dev/null || true)
  [[ -z "$hp" ]] && hp="(unset)"
  dim "INFO ($hp)\n"

  printf '%-40s' "prunable worktree metadata"
  if git_in "$canonical" worktree list --porcelain 2>/dev/null | grep -q '^prunable '; then
    yellow "WARN (run: git worktree prune)\n"
  else
    green "PASS\n"
  fi
  return 0
}

cmd_bootstrap() {
  local mode="repair" id="" record repo wt _id r_rp_path branch _sha _is_canonical canonical
  while (($#)); do
    case "$1" in
      --check) mode="check"; shift ;;
      --repair) mode="repair"; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) [[ -z "$id" ]] && id="$1" || die 10 "unexpected positional: $1"; shift ;;
    esac
  done
  [[ -n "$id" ]] || die 10 "usage: wt bootstrap [--check|--repair] <id>"
  record=$(wt_resolve_id "$id") || die 20 "no worktree '$id' in any configured repo"
  wt_record_fields "$record" repo _id wt r_rp_path branch _sha _is_canonical
  canonical=$(cfg_repo_get "$repo" path)
  if [[ "$mode" == "check" ]]; then
    printf '%s\n' "$(green "[$repo] bootstrap check $id") $wt"
    bootstrap_health_report "$repo" "$canonical" "$wt" check
    return $?
  fi
  run_bootstrap "$repo" "$canonical" "$wt" "$branch" "$_id"
}
generate_path_cache() {
  local record repo path wt_root tmp rp_path rp_wt_root rp_forbidden _base _default _workspace
