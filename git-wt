    (( refresh == 1 )) && git_in "$canonical" fetch origin "$default_branch" --quiet 2>/dev/null || true
    printf '%s\n' "$(green "[$repo]")"
    local rows; rows=$(git_in "$canonical" worktree list --porcelain 2>/dev/null) || continue
    {
      printf 'ID\tCLEAN\tPUSHED\tREACH\tTAB\tBRANCH\n'
      echo "$rows" | awk '
        /^worktree / { path=$2; next }
        /^HEAD / { sha=substr($2,1,10); next }
        /^branch / { ref=$2; sub(/^refs\/heads\//,"",ref); printf "%s\t%s\t%s\n", path, sha, ref; next }
        /^detached/ { printf "%s\t%s\t(detached)\n", path, sha; next }
      ' | while IFS=$'\t' read -r path sha ref; do
        [[ "$(rp "$path")" == "$(rp "$canonical")" ]] && continue
        local id="${path##*/}" c p r t
        is_clean "$path" && c=yes || c=no
        is_pushed "$path" && p=yes || p=no
        reachable_from "$path" "$default_branch" && r=yes || r=no
        t='-'
        if [[ -n "$ws_id" ]]; then
          local tab_id; tab_id=$(herdr_pane_for_cwd "$ws_id" "$path" || true)
          if [[ -n "$tab_id" ]]; then
            t=$(herdr_tab_status "$ws_id" "$tab_id"); [[ -z "$t" ]] && t=unknown
          else
            t=no-tab
          fi
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$c" "$p" "$r" "$t" "$ref"
      done
    } | column -t -s $'\t' | sed 's/^/  /'
  done
}
cmd_audit() {
  # Read-only check: list worktree branches with commits not yet on origin/<default>.
  # TSV output, one row per finding: repo\tid\tbranch\tahead\tstatus[\tdetail]
  # status in: unpushed | ahead-of-upstream | pushed-unmerged
  # Designed for machine consumption (PAI SessionStart hook).
  local fetch=1
  while (($#)); do
    case "$1" in
      --no-fetch) fetch=0; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) die 10 "unknown arg: $1" ;;
    esac
  done
  local repo
  for repo in $(cfg_repos); do
    local canonical default_branch
    canonical=$(cfg_repo_get "$repo" path)
    default_branch=$(cfg_repo_get "$repo" default_branch)
    (( fetch == 1 )) && git_in "$canonical" fetch origin "$default_branch" --quiet 2>/dev/null || true
    local rows; rows=$(git_in "$canonical" worktree list --porcelain 2>/dev/null) || continue
    echo "$rows" | awk '
      /^worktree / { path=$2; next }
      /^HEAD / { sha=substr($2,1,10); next }
      /^branch / { ref=$2; sub(/^refs\/heads\//,"",ref); printf "%s\t%s\t%s\n", path, sha, ref; next }
      /^detached/ { printf "%s\t%s\t(detached)\n", path, sha; next }
    ' | while IFS=$'\t' read -r path sha ref; do
      [[ "$(rp "$path")" == "$(rp "$canonical")" ]] && continue
      [[ "$ref" == "(detached)" ]] && continue
      [[ -d "$path" ]] || continue
      reachable_from "$path" "$default_branch" && continue
      local id="${path##*/}" status detail ahead_of_main ahead_of_up upstream
      ahead_of_main=$(git_in "$path" rev-list --count "origin/$default_branch..HEAD" 2>/dev/null || echo 0)
      if upstream=$(git_in "$path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
        ahead_of_up=$(git_in "$path" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)
        if [[ "$ahead_of_up" != "0" ]]; then
          status="ahead-of-upstream"
          detail="$ahead_of_up ahead of $upstream"
        else
          status="pushed-unmerged"
          detail="on $upstream, not merged to $default_branch"
        fi
      else
        status="unpushed"
        detail="no upstream"
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$repo" "$id" "$ref" "$ahead_of_main" "$status" "$detail"
    done
  done
}

cmd_reap() {
  guard_forbidden
  local force=0 dry=0 ids=()
  while (($#)); do
    case "$1" in
      --force) force=1; shift ;;
      --dry-run) dry=1; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) ids+=("$1"); shift ;;
    esac
  done
  (( ${#ids[@]} > 0 )) || die 10 "usage: wt reap [--force] [--dry-run] <id>..."

  local id repo
  for id in "${ids[@]}"; do
    repo=$(repo_for_id "$id") || die 20 "no worktree '$id' in any configured repo"
    local canonical wt_root ws_name ws_id default_branch path
    canonical=$(cfg_repo_get "$repo" path)
    wt_root=$(cfg_repo_get "$repo" worktree_root)
    ws_name=$(cfg_repo_get "$repo" herdr_workspace)
    default_branch=$(cfg_repo_get "$repo" default_branch)
    path="$wt_root/$id"
    ws_id=$(herdr_ws_id "$ws_name" || true)

    # Safety
    local refusals=()
    if [[ -d "$path" ]]; then
      is_clean "$path" || refusals+=("uncommitted-changes")
      is_pushed "$path" || refusals+=("unpushed-commits")
      reachable_from "$path" "$default_branch" || refusals+=("not-reachable-from-origin/$default_branch")
    fi
    if [[ -n "$ws_id" ]]; then
      local tab_id stt
      tab_id=$(herdr_pane_for_cwd "$ws_id" "$path" || true)
      if [[ -n "$tab_id" ]]; then
        stt=$(herdr_tab_status "$ws_id" "$tab_id")
        if [[ "$stt" == "working" ]]; then refusals+=("agent-working-in-tab"); fi
      fi
    fi
    # Process-cwd / open-files check (catches OMP sub-agents, editors, watchers, dev servers).
    # Run AFTER the cheap herdr check; lsof +D walks the worktree tree.
    if [[ -d "$path" ]] && command -v lsof >/dev/null 2>&1; then
      local lsof_out
      lsof_out=$(lsof +D "$path" 2>/dev/null | awk 'NR>1 {print $2}' | sort -u || true)
      if [[ -n "$lsof_out" ]]; then
        local n_pids; n_pids=$(echo "$lsof_out" | wc -l | tr -d ' ')
        refusals+=("files-open-by-${n_pids}-process(es)")
      fi
    fi
    if (( ${#refusals[@]} > 0 && force == 0 )); then
      printf '%s %s [%s]\n' "$(red REFUSE)" "$id" "$(IFS=,; echo "${refusals[*]}")"
      (( dry == 1 )) && continue
      die 70 "reap refused without --force (id=$id)"
    fi

    if (( dry == 1 )); then
      printf '%s %s\n' "$(yellow DRY)" "would reap id=$id path=$path branch=(see status)"
      continue
    fi

    acquire_lock "$wt_root"
    # 1. close tab first
    if [[ -n "$ws_id" ]]; then
      local tab_id
      tab_id=$(herdr_pane_for_cwd "$ws_id" "$path" || true)
      if [[ -n "$tab_id" ]]; then
        herdr_close_tab "$tab_id" || warn "couldn't close herdr tab $tab_id (continuing)"
      fi
    fi
    # 2. remove worktree
    local rp_path=$(rp "$path")
    local branch=""
    branch=$(git_in "$canonical" worktree list --porcelain 2>/dev/null \
              | awk -v p="$path" -v rp="$rp_path" 'BEGIN{f=0} $1=="worktree"{f=($2==p || $2==rp)} f && $1=="branch"{print $2; exit}')
    branch="${branch#refs/heads/}"
    if [[ -d "$path" ]]; then
      if ! git_in "$canonical" worktree remove "$path" --force >/dev/null 2>&1; then
        die 60 "git worktree remove failed; run 'wt repair' to reconcile"
      fi
    else
      git_in "$canonical" worktree prune >/dev/null 2>&1 || true
    fi
    # 3. delete branch if reachable from origin/<default>
    if [[ -n "$branch" ]]; then
      if git_in "$canonical" cherry "origin/$default_branch" "$branch" 2>/dev/null | grep -q '^+'; then
        warn "branch '$branch' has commits not in origin/$default_branch; not deleting"
      else
        git_in "$canonical" branch -D "$branch" >/dev/null 2>&1 || warn "branch -D failed for $branch"
      fi
    fi
    release_lock
    green "reaped "
    printf 'id=%s branch=%s\n' "$id" "$branch"
  done
}

