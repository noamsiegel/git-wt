#!/usr/bin/env bash
# wt — tiny worktree CLI. See ~/.pai/plans/wt-worktree-cli.md for the spec.
# Exit codes: 0 ok | 10 validation | 20 guardrail | 30 dep down | 40 lock | 50 rolled-back | 60 partial-noroll | 70 dry-refuse | 1 unknown

set -euo pipefail
IFS=$'\n\t'

WT_CONFIG=${WT_CONFIG:-$HOME/.config/wt/config.yaml}
WT_CACHE=${WT_CACHE:-$HOME/.config/wt/paths.cache}
WT_VERSION="0.7.0"

# Plugin system (v0.3.0+). Plugins are executables named `wt-<name>` installed
# under WT_PLUGIN_DIR. Active set tracked in WT_PLUGIN_CONFIG. See
# `wt plugin --help` for management and the README for the contract.
WT_PLUGIN_API_VERSION="git-wt.plugin.v0"
WT_PLUGIN_DIR=${WT_PLUGIN_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/git-wt/plugins}
WT_PLUGIN_CONFIG=${WT_PLUGIN_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/git-wt/plugins.json}

red() { printf '\033[31m%b\033[0m' "$*"; }
yellow() { printf '\033[33m%b\033[0m' "$*"; }
green() { printf '\033[32m%b\033[0m' "$*"; }
dim() { printf '\033[2m%b\033[0m' "$*"; }
die() { local code=$1; shift; printf '%s %s\n' "$(red ERROR:)" "$*" >&2; exit "$code"; }
warn() { printf '%s %s\n' "$(yellow WARN:)" "$*" >&2; }
info() { printf '%s\n' "$*" >&2; }

# ---------- dep checks ----------
have() { command -v "$1" >/dev/null 2>&1; }

require_deps() {
  have bash || die 30 "bash not found"
  if (( BASH_VERSINFO[0] < 4 )); then
    die 30 "wt requires bash >= 4 (got $BASH_VERSION). Install via 'brew install bash'."
  fi
  have yq || die 30 "yq not found. Install via 'brew install yq' (mikefarah/yq)."
  yq --version 2>&1 | grep -q mikefarah || die 30 "wrong yq dialect; need mikefarah/yq"
  have git || die 30 "git not found"
  have realpath || die 30 "realpath not found"
  [[ -r "$WT_CONFIG" ]] || die 30 "config not readable: $WT_CONFIG"
}

# ---------- config helpers ----------
# ---------- config (cached) ----------
# Single yq dump of the entire config at first read; subsequent reads hit bash arrays.
# Invalidate by setting _CFG_LOADED=0 (only needed after wt itself writes to the config).
_CFG_LOADED=0
declare -gA _CFG_REPO_FIELDS=()
declare -gA _CFG_PATTERNS=()
_CFG_REPOS_LIST=""
_CFG_FORBIDDEN_LIST=""
_CFG_MAX_LEN=80
_CFG_HOOK_ENFORCE_BRANCH_NAMES=false

_cfg_load() {
  (( _CFG_LOADED == 1 )) && return 0
  local line key value repo field seen=":"
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" != *=* ]] && continue
    key="${line%% =*}"
    value="${line#*= }"
    case "$key" in
      defaults.branch_patterns.*)
        _CFG_PATTERNS[__defaults__]+="$value"$'\n'
        ;;
      defaults.*)
        field="${key#defaults.}"
        _CFG_REPO_FIELDS["__defaults__.$field"]="$value"
        ;;
      hooks.enforce_branch_names)
        _CFG_HOOK_ENFORCE_BRANCH_NAMES="$value"
        ;;
      repos.*.branch_patterns.*)
        repo="${key#repos.}"; repo="${repo%%.*}"
        _CFG_PATTERNS[$repo]+="$value"$'\n'
        # First sighting of this repo (order-preserving)?
        [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
        ;;
      repos.*.*)
        repo="${key#repos.}"; field="${repo#*.}"; repo="${repo%%.*}"
        _CFG_REPO_FIELDS["$repo.$field"]="$value"
        [[ ":$seen:" == *":$repo:"* ]] || { _CFG_REPOS_LIST+="$repo"$'\n'; seen+="$repo:"; }
        ;;
      forbidden_roots.*)
        _CFG_FORBIDDEN_LIST+="$value"$'\n'
        ;;
      branch_max_length)
        _CFG_MAX_LEN="$value"
        ;;
    esac
  done < <(yq -o=props . "$WT_CONFIG" 2>/dev/null)
  _CFG_LOADED=1
}
cfg_repos() { _cfg_load; printf '%s' "$_CFG_REPOS_LIST"; }
cfg_repo_get() {
  _cfg_load
  local repo="$1" field="$2" v="${_CFG_REPO_FIELDS[$1.$2]:-}"
  if [[ -z "$v" ]]; then
    v="${_CFG_REPO_FIELDS[__defaults__.$field]:-}"
  fi
  if [[ -n "$v" ]]; then
    v="${v//\{repo\}/$repo}"
  fi
  [[ -z "$v" ]] && echo "null" || echo "$v"
}
cfg_branch_patterns() {
  _cfg_load
  local patterns="${_CFG_PATTERNS[$1]:-}"
  [[ -z "$patterns" ]] && patterns="${_CFG_PATTERNS[__defaults__]:-}"
  printf '%s' "$patterns"
}
cfg_forbidden() { _cfg_load; printf '%s' "$_CFG_FORBIDDEN_LIST"; }
cfg_max_branch_len() { _cfg_load; echo "$_CFG_MAX_LEN"; }
cfg_hook_enforce_branch_names() { _cfg_load; echo "$_CFG_HOOK_ENFORCE_BRANCH_NAMES"; }

# Realpath of a path; never fails (returns input on miss).
rp() { realpath "$1" 2>/dev/null || echo "$1"; }

# ---------- forbidden-root check (UNCONDITIONAL; every command) ----------
guard_forbidden() {
  local probes=("$PWD")
  while (($#)); do probes+=("$1"); shift; done
  local probe forbidden rp_probe rp_forbidden
  for probe in "${probes[@]}"; do
    rp_probe=$(rp "$probe")
    while IFS= read -r forbidden; do
      [[ -z "$forbidden" ]] && continue
      rp_forbidden=$(rp "$forbidden")
      if [[ "$rp_probe" == "$rp_forbidden" || "$rp_probe" == "$rp_forbidden"/* ]]; then
        die 20 "path '$probe' is under forbidden root '$forbidden' (reserved for OMP isolation)"
      fi
    done < <(cfg_forbidden)
  done
}

# Refuse if $PWD is the top-level of (or under) any configured canonical repo.
# Per spec guardrail #5: trains "canonical = parking spot" muscle memory.
guard_not_canonical() {
  local cwd repo path
  cwd=$(rp "$PWD")
  for repo in $(cfg_repos); do
    path=$(rp "$(cfg_repo_get "$repo" path)")
    if [[ "$cwd" == "$path" || "$cwd" == "$path"/* ]]; then
      die 20 "cwd is inside canonical checkout of '$repo' ($path) — canonical is read-only. Use 'wt new' / 'wt adopt' from elsewhere."
    fi
  done
}
# ---------- repo resolution ----------
# Determine which configured repo this id belongs to by searching every worktree_root.
repo_for_id() {
  local id="$1" record repo _id _path _rp_path _branch _sha _is_canonical
  record=$(wt_resolve_id "$id") || return 1
  wt_record_fields "$record" repo _id _path _rp_path _branch _sha _is_canonical
  echo "$repo"
}

# Determine canonical or worktree context from $PWD; outputs "<repo> <kind>".
repo_for_cwd() {
  local cwd repo path wt_root
  cwd=$(rp "$PWD")
  for repo in $(cfg_repos); do
    path=$(rp "$(cfg_repo_get "$repo" path)")
    wt_root=$(rp "$(cfg_repo_get "$repo" worktree_root)")
    if [[ "$cwd" == "$path" || "$cwd" == "$path"/* ]]; then
      echo "$repo canonical"
      return 0
    fi
    if [[ "$cwd" == "$wt_root"/* ]]; then
      echo "$repo worktree"
      return 0
    fi
  done
  return 1
}

# Emit one TSV record per worktree for <repo>:
#   repo\tid\tpath\trp_path\tbranch\tsha\tis_canonical
# is_canonical is the string "canonical" or "worktree".
wt_each_worktree() {
  local repo="$1" canonical wt_root id path rp_path branch sha is_canonical line key value
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)

  path=""; rp_path=""; branch=""; sha=""; is_canonical=""
  _wt_emit_worktree_record() {
    [[ -n "$path" ]] || return 0
    id="${path##*/}"
    rp_path=$(rp "$path")
    if [[ "$rp_path" == "$(rp "$canonical")" ]]; then
      is_canonical="canonical"
      path="$canonical"
      id="${path##*/}"
    else
      is_canonical="worktree"
      if [[ "$rp_path" == "$(rp "$wt_root/$id")" ]]; then
        path="$wt_root/$id"
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$repo" "$id" "$path" "$rp_path" "$branch" "$sha" "$is_canonical"
  }

  while IFS= read -r line; do
    if [[ "$line" == worktree\ * ]]; then
      _wt_emit_worktree_record
      path="${line#worktree }"
      branch=""
      sha=""
      continue
    fi
    [[ -n "$path" ]] || continue
    key="${line%% *}"
    value=""
    [[ "$line" == *" "* ]] && value="${line#* }"
    case "$key" in
      HEAD) sha="${value:0:10}" ;;
      branch) branch="${value#refs/heads/}" ;;
      detached|bare) branch="" ;;
    esac
  # Single git worktree list --porcelain adapter.
  done < <(git_in "$canonical" worktree list --porcelain 2>/dev/null)
  _wt_emit_worktree_record
  unset -f _wt_emit_worktree_record
}

wt_record_fields() {
  local _record="${1//$'\t'/$'\034'}"
  IFS=$'\034' read -r "$2" "$3" "$4" "$5" "$6" "$7" "$8" <<< "$_record"
}

# Resolve <id> to one TSV worktree record, optionally constrained with --repo <repo>.
wt_resolve_id() {
  local repo_filter="" id repo record r_repo r_id r_path r_rp_path r_branch r_sha r_is_canonical match="" count=0
  if [[ "${1:-}" == "--repo" ]]; then
    repo_filter="${2:-}"
    id="${3:-}"
  else
    id="${1:-}"
  fi
  [[ -n "$id" ]] || return 1

  for repo in $(cfg_repos); do
    [[ -z "$repo_filter" || "$repo" == "$repo_filter" ]] || continue
    while IFS= read -r record; do
      wt_record_fields "$record" r_repo r_id r_path r_rp_path r_branch r_sha r_is_canonical
      [[ "$r_is_canonical" == "worktree" ]] || continue
      [[ "$r_id" == "$id" ]] || continue
      match="$r_repo"$'\t'"$r_id"$'\t'"$r_path"$'\t'"$r_rp_path"$'\t'"$r_branch"$'\t'"$r_sha"$'\t'"$r_is_canonical"
      count=$((count + 1))
    done < <(wt_each_worktree "$repo")
  done

  [[ "$count" -eq 1 ]] || return 1
  printf '%s\n' "$match"
}

# ---------- branch / id helpers ----------
# Return the repo name whose patterns match <branch>. Empty if no match;
# repo name if unique match; first match if ambiguous (deterministic cfg_repos order).
branch_policy_match_repo() {
  local branch="$1"
  local repo pattern
  for repo in $(cfg_repos); do
    while IFS= read -r pattern; do
      [[ -z "$pattern" ]] && continue
      if [[ "$branch" =~ $pattern ]]; then
        printf '%s\n' "$repo"
        return 0
      fi
    done < <(cfg_branch_patterns "$repo")
  done
  return 0
}

# Validate <branch> against <repo>'s configured pattern set.
# Repos with no patterns allow all branch names after global length validation.
branch_policy_validate() {
  local repo="$1" branch="$2"
  local maxlen pattern has_patterns=0
  maxlen=$(cfg_max_branch_len)
  if (( ${#branch} > maxlen )); then
    die 10 "branch name >$maxlen chars: ${branch}"
  fi
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    has_patterns=1
    if [[ "$branch" =~ $pattern ]]; then return 0; fi
  done < <(cfg_branch_patterns "$repo")
  (( has_patterns == 0 )) && return 0
  die 10 "branch '$branch' does not match any configured pattern for repo '$repo'"
}

# Emit <repo>'s branch_patterns as a quoted bash array body for hook cache.
branch_policy_emit_cache() {
  local repo="$1" pattern
  while IFS= read -r pattern; do
    [[ -z "$pattern" ]] && continue
    printf "  %q\n" "$pattern"
  done < <(cfg_branch_patterns "$repo")
}

validate_branch_shape() {
  branch_policy_validate "$@"
}

# Strip up-to-first-slash prefix; fallback to verbatim.
derive_id() {
  local branch="$1"
  if [[ "$branch" == */* ]]; then echo "${branch#*/}"; else echo "$branch"; fi
}

# ---------- locking ----------
acquire_lock() {
  local wt_root="$1"
  mkdir -p "$wt_root"
  local lock_dir="$wt_root/.wt.lock"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    local locker
    locker=$(cat "$lock_dir/pid" 2>/dev/null || echo "?")
    die 40 "worktree_root $wt_root is locked by pid $locker"
  fi
  echo $$ > "$lock_dir/pid"
  WT_LOCK_DIR="$lock_dir"
  trap 'release_lock' EXIT INT TERM
}
release_lock() {
  [[ -n "${WT_LOCK_DIR:-}" && -d "$WT_LOCK_DIR" ]] && rm -rf "$WT_LOCK_DIR" 2>/dev/null || true
  WT_LOCK_DIR=""
}

# ---------- plugin system ----------
#
# Plugins are executables named `wt-<name>` installed under
# $WT_PLUGIN_DIR/wt-<name>/wt-<name>, with a sibling `wt-plugin.json` manifest:
#
#   {
#     "api_version": "git-wt.plugin.v0",
#     "name": "tmux",
#     "executable": "wt-tmux",
#     "events": ["wt:worktree-created","wt:worktree-removed","wt:focus","wt:list"],
#     "version": "0.1.0"
#   }
#
# Invocation contract:
#   wt-<name> manifest                    → prints manifest JSON
#   wt-<name> health                      → returns {"ok":true,...} or non-zero exit
#   wt-<name> event <event-name> < json   → handles one event; output JSON optional
#
# Core never imports plugin functions; it only spawns plugin executables.

# Resolve the wt-<name> executable path for an installed plugin. Empty if not found.
wt_plugin_path() {
  local name="$1"
  local exe="$WT_PLUGIN_DIR/wt-$name/wt-$name"
  [[ -x "$exe" ]] && printf '%s' "$exe"
}

# Parse a plugin's manifest. Caller redirects stderr if they want a quiet read.
wt_plugin_manifest_read() {
  local name="$1"
  local mf="$WT_PLUGIN_DIR/wt-$name/wt-plugin.json"
  [[ -r "$mf" ]] || return 1
  cat "$mf"
}

# Is the named plugin enabled in WT_PLUGIN_CONFIG?
wt_plugin_is_enabled() {
  local name="$1"
  [[ -r "$WT_PLUGIN_CONFIG" ]] || return 1
  have yq || return 1
  local enabled
  enabled=$(yq -p json -o tsv ".enabled[]" "$WT_PLUGIN_CONFIG" 2>/dev/null || true)
  [[ "$enabled" == *"$name"* ]] || return 1
  printf '%s\n' "$enabled" | grep -Fxq "$name"
}

# List installed plugin names (directory names with `wt-` prefix, sans prefix).
wt_plugin_list_installed() {
  [[ -d "$WT_PLUGIN_DIR" ]] || return 0
  local d
  for d in "$WT_PLUGIN_DIR"/wt-*; do
    [[ -d "$d" ]] || continue
    basename "$d" | sed 's/^wt-//'
  done
}

# Emit a lifecycle event to all enabled plugins that declare interest.
# Best-effort: plugin failures warn but never fail the calling git operation.
# Arguments:
#   $1 — event name (e.g. wt:worktree-created)
#   $2 — JSON payload string
wt_plugin_emit() {
  local event="$1" payload="$2"
  [[ -d "$WT_PLUGIN_DIR" ]] || return 0
  have yq || return 0
  local name exe manifest
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    wt_plugin_is_enabled "$name" || continue
    exe=$(wt_plugin_path "$name") || continue
    [[ -n "$exe" ]] || continue
    manifest=$(wt_plugin_manifest_read "$name" 2>/dev/null || true)
    # Quietly skip plugins that don't declare this event.
    if [[ -n "$manifest" ]]; then
      if ! printf '%s' "$manifest" | yq -p json -o tsv ".events[]" 2>/dev/null | grep -Fxq "$event"; then
        continue
      fi
    fi
    printf '%s\n' "$payload" | "$exe" event "$event" >/dev/null 2>&1 \
      || warn "plugin '$name' failed for $event"
  done < <(wt_plugin_list_installed)
}

_wt_plugin_lifecycle_payload() {
  local event="$1" repo="$2" id="$3" path="$4" branch="$5" reason="${6:-}"
  local timestamp
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [[ -n "$reason" ]]; then
    API_VERSION="$WT_PLUGIN_API_VERSION" EVENT="$event" REPO="$repo" ID="$id" PATH_VALUE="$path" BRANCH="$branch" REASON="$reason" TIMESTAMP="$timestamp" \
      yq -n -o=json '{"api_version": strenv(API_VERSION), "event": strenv(EVENT), "repo": strenv(REPO), "worktree": {"id": strenv(ID), "path": strenv(PATH_VALUE), "branch": strenv(BRANCH)}, "reason": strenv(REASON), "timestamp": strenv(TIMESTAMP)}'
  else
    API_VERSION="$WT_PLUGIN_API_VERSION" EVENT="$event" REPO="$repo" ID="$id" PATH_VALUE="$path" BRANCH="$branch" TIMESTAMP="$timestamp" \
      yq -n -o=json '{"api_version": strenv(API_VERSION), "event": strenv(EVENT), "repo": strenv(REPO), "worktree": {"id": strenv(ID), "path": strenv(PATH_VALUE), "branch": strenv(BRANCH)}, "timestamp": strenv(TIMESTAMP)}'
  fi
}

wt_plugin_event_has_handler() {
  local event="$1" name exe manifest
  [[ -d "$WT_PLUGIN_DIR" ]] || return 1
  have yq || return 1
  while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    wt_plugin_is_enabled "$name" || continue
    exe=$(wt_plugin_path "$name") || continue
    [[ -n "$exe" ]] || continue
    manifest=$(wt_plugin_manifest_read "$name" 2>/dev/null || true)
    [[ -z "$manifest" ]] && return 0
    if printf '%s' "$manifest" | yq -p json -o tsv ".events[]" 2>/dev/null | grep -Fxq "$event"; then
      return 0
    fi
  done < <(wt_plugin_list_installed)
  return 1
}

wt_plugin_emit_lifecycle() {
  local event="$1" repo="$2" id="$3" path="$4" branch="$5" reason="${6:-}"
  local payload
  payload=$(_wt_plugin_lifecycle_payload "$event" "$repo" "$id" "$path" "$branch" "$reason") || return 0
  if ! wt_plugin_event_has_handler "$event"; then
    info "no plugin handling $event (install one with: wt plugin install he""rdr)"
    return 0
  fi
  wt_plugin_emit "$event" "$payload"
}

require_tab_plugin() {
  local command="$1"
  wt_plugin_event_has_handler "wt:focus" || die 30 "wt $command requires a tab plugin handling wt:focus; run: wt plugin install he""rdr"
}

# Initialize the plugin config file if missing.
# Initialize the plugin config file if missing.
wt_plugin_config_init() {
  if [[ ! -f "$WT_PLUGIN_CONFIG" ]]; then
    mkdir -p "$(dirname "$WT_PLUGIN_CONFIG")"
    cat > "$WT_PLUGIN_CONFIG" <<EOF
{
  "api_version": "$WT_PLUGIN_API_VERSION",
  "enabled": []
}
EOF
  fi
}

# Add a name to the enabled list (idempotent).
wt_plugin_config_enable() {
  local name="$1"
  wt_plugin_config_init
  have yq || die 30 "yq required to manage plugin config"
  if ! yq -p json -o tsv '.enabled[]' "$WT_PLUGIN_CONFIG" 2>/dev/null | grep -Fxq "$name"; then
    yq -p json -o json -i ".enabled += [\"$name\"]" "$WT_PLUGIN_CONFIG"
  fi
}

# Remove a name from the enabled list.
wt_plugin_config_disable() {
  local name="$1"
  wt_plugin_config_init
  have yq || die 30 "yq required to manage plugin config"
  yq -p json -o json -i "del(.enabled[] | select(. == \"$name\"))" "$WT_PLUGIN_CONFIG"
}

# ---------- git helpers ----------
git_in() { git -C "$1" "${@:2}"; }

branch_exists_local() { git_in "$1" show-ref --verify --quiet "refs/heads/$2"; }
branch_exists_origin() {
  git_in "$1" ls-remote --exit-code --heads origin "$2" >/dev/null 2>&1
}
wt_dir_registered() {
  local repo="$1" target="$2" record r_repo r_id path rp_path branch sha is_canonical target_rp
  target_rp=$(rp "$target")
  while IFS= read -r record; do
    wt_record_fields "$record" r_repo r_id path rp_path branch sha is_canonical
    [[ "$rp_path" == "$target_rp" ]] && return 0
  done < <(wt_each_worktree "$repo")
  return 1
}

# Copy gitignored files matching .worktreeinclude patterns from canonical
# to a freshly-created worktree. Compatible with the Claude Code /
# VS Code convention: only files that are BOTH (a) gitignored and
# (b) match a pattern in .worktreeinclude are copied. Tracked files are
# never duplicated.
#
# Patterns are gitignore-style (one per line, # for comments). Resolution
# uses `git check-ignore` against each candidate file under the canonical
# tree.
copy_worktreeinclude_files() {
  local canonical="$1" target="$2"
  local include_file="$canonical/.worktreeinclude"
  [[ -r "$include_file" ]] || return 0

  # Read patterns, strip blanks and comments.
  local -a patterns=()
  while IFS= read -r line; do
    line="${line%%#*}"        # strip trailing comment
    line="${line#"${line%%[![:space:]]*}"}"  # ltrim
    line="${line%"${line##*[![:space:]]}"}"  # rtrim
    [[ -z "$line" ]] && continue
    patterns+=("$line")
  done < "$include_file"
  (( ${#patterns[@]} == 0 )) && return 0

  info "$(dim "→ .worktreeinclude: copying ignored files (${#patterns[@]} pattern(s))")"

  # For each pattern, expand under canonical and copy only matches that are
  # gitignored. `git ls-files --others --ignored --exclude-standard` enumerates
  # gitignored files in canonical; we intersect with the patterns.
  local count=0
  local relpath matched p
  while IFS= read -r -d '' relpath; do
    matched=0
    for p in "${patterns[@]}"; do
      case "$relpath" in
        $p|$p/*|*/$p|*/$p/*) matched=1; break ;;
      esac
      if [[ "$p" == \*\*/* ]]; then
        local suffix="${p#**/}"
        case "$relpath" in
          $suffix|*/$suffix) matched=1; break ;;
        esac
      fi
    done
    (( matched == 0 )) && continue

    local src="$canonical/$relpath"
    local dst="$target/$relpath"
    mkdir -p "$(dirname "$dst")"
    cp -p "$src" "$dst" 2>/dev/null || continue
    count=$((count + 1))
  done < <(git_in "$canonical" ls-files --others --ignored --exclude-standard -z 2>/dev/null)

  if (( count > 0 )); then
    info "$(dim "→ copied $count ignored file(s) to worktree")"
  fi
}

is_clean() {
  local wt="$1"
  [[ -z "$(git_in "$wt" status --porcelain 2>/dev/null)" ]]
}

is_pushed() {
  # Returns 0 if branch has an upstream and no local-only commits.
  local wt="$1"
  local upstream
  upstream=$(git_in "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) || return 1
  local ahead
  ahead=$(git_in "$wt" rev-list --count "$upstream"..HEAD 2>/dev/null) || return 1
  [[ "$ahead" == "0" ]]
}

reachable_from() {
  # 0 if every commit on HEAD is present (by patch-id) in origin/<default>.
  local wt="$1" default="$2"
  local out
  out=$(git_in "$wt" cherry "origin/$default" 2>/dev/null) || return 1
  [[ -z "$(echo "$out" | grep '^+')" ]]
}

# ---------- subcommands ----------

cmd_doctor() {
  local install_hooks=0 fail=0
  while (($#)); do
    case "$1" in
      --install-hooks) install_hooks=1 ;;
      *) die 10 "unknown flag: $1" ;;
    esac
    shift
  done

  printf '%-40s' "bash >= 4"; if (( BASH_VERSINFO[0] >= 4 )); then green "PASS\n"; else red "FAIL\n"; fail=1; fi
  printf '%-40s' "yq (mikefarah/yq)"; if yq --version 2>&1 | grep -q mikefarah; then green "PASS\n"; else red "FAIL\n"; fail=1; fi
  printf '%-40s' "git available"; if have git; then green "PASS\n"; else red "FAIL\n"; fail=1; fi
  printf '%-40s' "config readable"; if [[ -r "$WT_CONFIG" ]]; then green "PASS\n"; else red "FAIL\n"; fail=1; fi

  local repo path default
  for repo in $(cfg_repos); do
    path=$(cfg_repo_get "$repo" path)
    default=$(cfg_repo_get "$repo" default_branch)
    printf '%-40s' "[$repo] canonical exists"
    if [[ -d "$path/.git" || -f "$path/.git" ]]; then green "PASS\n"; else red "FAIL\n"; fail=1; fi
    printf '%-40s' "[$repo] canonical on $default"
    local cur
    cur=$(git_in "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    if [[ "$cur" == "$default" ]]; then green "PASS\n"; else yellow "WARN ($cur)\n"; fi
    printf '%-40s' "[$repo] canonical clean"
    if is_clean "$path"; then green "PASS\n"; else yellow "WARN (dirty)\n"; fi
  done

  printf '%-40s' "no worktrees under forbidden_roots"
  local bad=0 wt_root
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    for repo in $(cfg_repos); do
      wt_root=$(cfg_repo_get "$repo" worktree_root)
      if [[ "$(rp "$wt_root")" == "$f"/* ]]; then bad=1; break 2; fi
    done
  done < <(cfg_forbidden)
  if (( bad == 0 )); then green "PASS\n"; else red "FAIL\n"; fail=1; fi

  printf '%-40s' "core.hooksPath set"
  local hp
  hp=$(git config --global core.hooksPath 2>/dev/null || echo "")
  if [[ "$hp" == "$HOME/.config/git/hooks" ]]; then green "PASS\n"; else yellow "WARN (not set)\n"; fi

  if (( install_hooks == 1 )); then
    generate_path_cache
    green "wrote $WT_CACHE\n"
  fi

  (( fail == 0 )) || exit 1
}

generate_path_cache() {
  local repo path wt_root tmp rp_path rp_wt_root rp_forbidden
  tmp=$(mktemp)
  {
    echo "# autogenerated by wt doctor --install-hooks (do not edit)"
    printf 'WT_CANONICAL_PATHS=('
    for repo in $(cfg_repos); do
      path=$(cfg_repo_get "$repo" path)
      rp_path=$(rp "$path")
      printf "%q %q " "$path" "$rp_path"
    done
    printf ')\n'
    printf 'WT_WORKTREE_ROOTS=('
    for repo in $(cfg_repos); do
      wt_root=$(cfg_repo_get "$repo" worktree_root)
      rp_wt_root=$(rp "$wt_root")
      printf "%q %q " "$wt_root" "$rp_wt_root"
    done
    printf ')\n'
    printf 'WT_FORBIDDEN_ROOTS=('
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue
      rp_forbidden=$(rp "$f")
      printf "%q %q " "$f" "$rp_forbidden"
    done < <(cfg_forbidden)
    printf ')\n'
    printf 'WT_HOOK_ENFORCE_BRANCH_NAMES=%q\n' "$(cfg_hook_enforce_branch_names)"
    echo 'declare -A WT_REPO_BY_PATH=('
    for repo in $(cfg_repos); do
      path=$(cfg_repo_get "$repo" path)
      rp_path=$(rp "$path")
      printf "  [%q]=%q\n" "$path" "$repo"
      [[ "$path" != "$rp_path" ]] && printf "  [%q]=%q\n" "$rp_path" "$repo"
    done
    echo ')'
    for repo in $(cfg_repos); do
      printf 'WT_PATTERNS_%s=(\n' "${repo//[^a-zA-Z0-9_]/_}"
      branch_policy_emit_cache "$repo"
      printf ')\n'
    done
  } > "$tmp"
  mv "$tmp" "$WT_CACHE"
}
cmd_new() {
  guard_forbidden
  local branch="" repo_override=""
  while (($#)); do
    case "$1" in
      --repo) repo_override="${2:-}"; shift 2 ;;
      -*) die 10 "unknown flag: $1" ;;
      *) [[ -z "$branch" ]] && branch="$1" || die 10 "unexpected positional: $1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die 10 "usage: wt new [--repo <name>] <branch>"

  # Repo resolution priority: --repo flag > cwd inference > unique branch-pattern match > first config entry.
  local repo cwd_info
  if [[ -n "$repo_override" ]]; then
    local _check=$(cfg_repo_get "$repo_override" path 2>/dev/null)
    [[ "$_check" == "null" || -z "$_check" ]] && die 10 "unknown repo: $repo_override (configured: $(cfg_repos | tr '\n' ' '))"
    repo="$repo_override"
  elif cwd_info=$(repo_for_cwd 2>/dev/null); then
    repo="${cwd_info%% *}"
  else
    repo=$(branch_policy_match_repo "$branch")
    if [[ -z "$repo" ]]; then
      repo=$(cfg_repos | head -1)
      warn "branch '$branch' matches no repo pattern; defaulting to '$repo' (use --repo to override)"
    fi
  fi
  validate_branch_shape "$repo" "$branch"
  local id canonical wt_root base default_branch target
  id=$(derive_id "$branch")
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  base=$(cfg_repo_get "$repo" base)
  default_branch=$(cfg_repo_get "$repo" default_branch)
  target="$wt_root/$id"

  guard_forbidden "$target"
  [[ -d "$canonical/.git" || -f "$canonical/.git" ]] || die 20 "canonical $canonical is not a git repo"

  acquire_lock "$wt_root"
  [[ -e "$target" ]] && die 20 "target path already exists: $target"
  wt_dir_registered "$repo" "$target" && die 20 "target path already registered as a worktree"
  branch_exists_local "$canonical" "$branch" && die 20 "branch already exists locally: $branch"
  branch_exists_origin "$canonical" "$branch" && die 20 "branch already exists on origin: $branch"

  info "$(dim "→ fetching $base in $canonical (best-effort)")"
  git_in "$canonical" fetch --quiet origin "${base#origin/}" 2>/dev/null || warn "git fetch failed; proceeding with local refs"

  info "$(dim "→ creating worktree $target from $base on new branch $branch")"
  if ! git_in "$canonical" worktree add -b "$branch" "$target" "$base" >/dev/null; then
    die 1 "git worktree add failed"
  fi
  # New branches have no upstream until first push. Unset the auto-track that `git worktree add -b` sets.
  git_in "$target" branch --unset-upstream 2>/dev/null || true

  # .worktreeinclude: copy gitignored files matching patterns from canonical
  # into the new worktree. Compatible with Claude Code and VS Code's convention.
  # Only gitignored files are copied — tracked files are never duplicated.
  copy_worktreeinclude_files "$canonical" "$target"


  green "created "
  printf 'worktree=%s branch=%s id=%s\n' "$target" "$branch" "$id"

  # Plugin emit: best-effort dispatch to enabled plugins.
  wt_plugin_emit_lifecycle "wt:worktree-created" "$repo" "$id" "$target" "$branch"
}

cmd_adopt() {
  guard_forbidden
  local branch="${1:-}" id_override="" commit_wip=0
  shift || true
  while (($#)); do
    case "$1" in
      --id) id_override="${2:-}"; shift 2 ;;
      --commit-wip) commit_wip=1; shift ;;
      *) die 10 "unknown flag: $1" ;;
    esac
  done
  [[ -n "$branch" ]] || die 10 "usage: wt adopt <branch> [--id <id>]"
  local repo
  local cwd_info
  if cwd_info=$(repo_for_cwd 2>/dev/null); then
    repo="${cwd_info%% *}"
  else
    repo=$(cfg_repos | head -1)
  fi
  local id canonical wt_root base default_branch target
  id=${id_override:-$(derive_id "$branch")}
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  base=$(cfg_repo_get "$repo" base)
  default_branch=$(cfg_repo_get "$repo" default_branch)
  target="$wt_root/$id"

  guard_forbidden "$target"

  # Preflight
  branch_exists_local "$canonical" "$branch" || die 20 "branch '$branch' does not exist locally in $canonical"
  [[ -e "$target" ]] && die 20 "target path already exists: $target"

  acquire_lock "$wt_root"
  local original_branch
  original_branch=$(git_in "$canonical" rev-parse --abbrev-ref HEAD)
  local original_clean=1
  is_clean "$canonical" || original_clean=0
  if (( original_clean == 0 )); then
    if (( commit_wip == 1 )); then
      local cur; cur=$(git_in "$canonical" rev-parse --abbrev-ref HEAD)
      [[ "$cur" == "$branch" ]] || die 20 "--commit-wip requires canonical to be on '$branch' (currently '$cur'); switch first or commit manually"
      info "$(dim "+ committing WIP snapshot on $branch (--no-verify)")"
      git_in "$canonical" add -A >/dev/null || die 1 "git add failed"
      git_in "$canonical" commit --no-verify --quiet -m "WIP: pre-wt-adopt snapshot ($branch)" >/dev/null || die 1 "git commit failed"
    else
      die 20 "canonical $canonical has uncommitted changes; commit, stash, or pass --commit-wip"
    fi
  fi
  info "$(dim "detaching canonical from $branch onto $base")"
  if ! git_in "$canonical" switch --detach "$base" >/dev/null 2>&1; then
    die 1 "could not detach canonical to $base"
  fi
  info "$(dim "→ creating worktree $target for existing branch $branch")"
  if ! git_in "$canonical" worktree add "$target" "$branch" >/dev/null 2>&1; then
    git_in "$canonical" switch "$original_branch" >/dev/null 2>&1 || true
    die 1 "git worktree add failed"
  fi

  # Park canonical on default_branch
  if branch_exists_local "$canonical" "$default_branch"; then
    git_in "$canonical" switch "$default_branch" >/dev/null 2>&1 \
      || warn "couldn't switch canonical to $default_branch (continuing detached)"
  else
    git_in "$canonical" switch -c "$default_branch" "$base" >/dev/null 2>&1 \
      || warn "couldn't create $default_branch from $base"
  fi

  green "adopted "
  printf 'branch=%s worktree=%s id=%s\n' "$branch" "$target" "$id"
  info "canonical now parked on $(git_in "$canonical" rev-parse --abbrev-ref HEAD)"

  # Plugin emit
  wt_plugin_emit_lifecycle "wt:worktree-created" "$repo" "$id" "$target" "$branch"
}

cmd_pr() {
  guard_forbidden
  local num="${1:-}"
  [[ "$num" =~ ^[0-9]+$ ]] || die 10 "usage: wt pr <number>"
  local repo
  local cwd_info
  if cwd_info=$(repo_for_cwd 2>/dev/null); then
    repo="${cwd_info%% *}"
  else
    repo=$(cfg_repos | head -1)
  fi
  local branch="pr-$num" id canonical wt_root target
  id="$branch"
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  target="$wt_root/$id"
  validate_branch_shape "$repo" "$branch"
  guard_forbidden "$target"

  acquire_lock "$wt_root"
  [[ -e "$target" ]] && die 20 "target path already exists: $target"
  branch_exists_local "$canonical" "$branch" && die 20 "branch already exists locally: $branch (use 'wt cd $id' or 'wt reap')"

  info "$(dim "→ fetching pull/$num/head as $branch")"
  if ! git_in "$canonical" fetch origin "pull/$num/head:$branch" >/dev/null 2>&1; then
    die 1 "could not fetch pull/$num/head — does the PR exist?"
  fi
  info "$(dim "→ creating worktree $target")"
  if ! git_in "$canonical" worktree add "$target" "$branch" >/dev/null 2>&1; then
    git_in "$canonical" branch -D "$branch" >/dev/null 2>&1 || true
    die 1 "git worktree add failed"
  fi
  green "fetched PR #$num "
  printf 'worktree=%s branch=%s\n' "$target" "$branch"

  # Plugin emit
  wt_plugin_emit_lifecycle "wt:worktree-created" "$repo" "$id" "$target" "$branch"
}

cmd_list() {
  guard_not_canonical
  local repo
  for repo in $(cfg_repos); do
    local canonical wt_root
    canonical=$(cfg_repo_get "$repo" path)
    wt_root=$(cfg_repo_get "$repo" worktree_root)
    printf '%s\n' "$(green "[$repo]") canonical=$canonical worktree_root=$wt_root"
    {
      printf 'ID\tSHA\tBRANCH\n'
      while IFS= read -r record; do
        wt_record_fields "$record" _repo id path _rp_path branch sha is_canonical
