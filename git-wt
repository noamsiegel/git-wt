      rp_path=$(rp "$path")
      printf "%q " "$path"
      [[ "$path" != "$rp_path" ]] && printf "%q " "$rp_path"
    done < <(cfg_each_repo_record)
    printf ')\n'
    printf 'WT_REPO_NAMES=('
    while IFS= read -r record; do
      wt_record_fields "$record" repo path wt_root _base _default _workspace
      rp_path=$(rp "$path")
      printf "%q " "$repo"
      [[ "$path" != "$rp_path" ]] && printf "%q " "$repo"
    done < <(cfg_each_repo_record)
    printf ')\n'
    cat <<'EOF'
wt_repo_by_path() {
  local needle="$1" i=0
  while [ "$i" -lt "${#WT_REPO_PATHS[@]}" ]; do
    if [ "${WT_REPO_PATHS[$i]}" = "$needle" ]; then
      printf '%s\n' "${WT_REPO_NAMES[$i]}"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}
EOF
    while IFS= read -r record; do
      wt_record_fields "$record" repo path wt_root _base _default _workspace
      printf 'WT_PATTERNS_%s=(\n' "${repo//[^a-zA-Z0-9_]/_}"
      branch_policy_emit_cache "$repo"
      printf ')\n'
      printf 'WT_AUTOPUSH_%s=%s\n' "${repo//[^a-zA-Z0-9_]/_}" "$(cfg_repo_autopush "$repo")"
    done < <(cfg_each_repo_record)
  } > "$tmp"
  mv "$tmp" "$WT_CACHE"
}
cmd_new() {
  guard_forbidden
  local branch="" repo_override="" allow_duplicate_issue_key=0
  while (($#)); do
    case "$1" in
      --repo) repo_override="${2:-}"; shift 2 ;;
      --allow-duplicate-issue-key) allow_duplicate_issue_key=1; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) [[ -z "$branch" ]] && branch="$1" || die 10 "unexpected positional: $1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die 10 "usage: wt new [--repo <name>] [--allow-duplicate-issue-key] <branch>"

  # Repo resolution priority: --repo flag > cwd inference > unique branch-pattern match > first config entry.
  local repo cwd_info
  if [[ -n "$repo_override" ]]; then
    local _check=$(cfg_repo_get "$repo_override" path 2>/dev/null)
    [[ "$_check" == "null" || -z "$_check" ]] && die 10 "unknown repo: $repo_override (configured: $(cfg_repos | tr '\n' ' '))"
    repo="$repo_override"
  elif cwd_info=$(repo_for_cwd 2>/dev/null); then
    repo="${cwd_info%% *}"
  else
    repo=$(branch_policy_match_repo "$branch")
    if [[ -z "$repo" ]]; then
      repo=$(cfg_repos | head -1)
      warn "branch '$branch' matches no repo pattern; defaulting to '$repo' (use --repo to override)"
    fi
  fi
  validate_branch_shape "$repo" "$branch"
  local id canonical wt_root base default_branch target
  id=$(derive_id "$branch")
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  base=$(cfg_repo_get "$repo" base)
  default_branch=$(cfg_repo_get "$repo" default_branch)
  target="$wt_root/$id"

  guard_forbidden "$target"
  [[ -d "$canonical/.git" || -f "$canonical/.git" ]] || die 20 "canonical $canonical is not a git repo"

  acquire_lock "$wt_root"
  branch_issue_key_validate_unique "$repo" "$branch" "$allow_duplicate_issue_key"
  [[ -e "$target" ]] && die 20 "target path already exists: $target"
  wt_dir_registered "$repo" "$target" && die 20 "target path already registered as a worktree"
  branch_exists_local "$canonical" "$branch" && die 20 "branch already exists locally: $branch"
  branch_exists_origin "$canonical" "$branch" && die 20 "branch already exists on origin: $branch"

  info "$(dim "→ fetching $base in $canonical (best-effort)")"
  git_in "$canonical" fetch --quiet origin "${base#origin/}" 2>/dev/null || warn "git fetch failed; proceeding with local refs"

  info "$(dim "→ creating worktree $target from $base on new branch $branch")"
  if ! git_in "$canonical" worktree add -b "$branch" "$target" "$base" >/dev/null; then
    die 1 "git worktree add failed"
  fi
  # New branches have no upstream until first push. Unset the auto-track that `git worktree add -b` sets.
  git_in "$target" branch --unset-upstream 2>/dev/null || true

  # .worktreeinclude: copy gitignored files matching patterns from canonical
  # into the new worktree. Compatible with Claude Code and VS Code's convention.
  # Only gitignored files are copied — tracked files are never duplicated.
  copy_worktreeinclude_files "$canonical" "$target"
  run_bootstrap "$repo" "$canonical" "$target" "$branch" "$id"


  green "created "
  printf 'worktree=%s branch=%s id=%s\n' "$target" "$branch" "$id"

  # Plugin emit: best-effort dispatch to enabled plugins.
  wt_plugin_emit_lifecycle "wt:worktree-created" "$repo" "$id" "$target" "$branch"
}

cmd_adopt() {
  guard_forbidden
  local branch="${1:-}" id_override="" commit_wip=0 allow_duplicate_issue_key=0
  shift || true
  while (($#)); do
    case "$1" in
      --id) id_override="${2:-}"; shift 2 ;;
      --commit-wip) commit_wip=1; shift ;;
      --allow-duplicate-issue-key) allow_duplicate_issue_key=1; shift ;;
      *) die 10 "unknown flag: $1" ;;
    esac
  done
  [[ -n "$branch" ]] || die 10 "usage: wt adopt <branch> [--id <id>] [--commit-wip] [--allow-duplicate-issue-key]"
  local repo
  local cwd_info
  if cwd_info=$(repo_for_cwd 2>/dev/null); then
    repo="${cwd_info%% *}"
  else
    repo=$(cfg_repos | head -1)
  fi
  local id canonical wt_root base default_branch target
  id=${id_override:-$(derive_id "$branch")}
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  base=$(cfg_repo_get "$repo" base)
  default_branch=$(cfg_repo_get "$repo" default_branch)
  target="$wt_root/$id"

  guard_forbidden "$target"

  # Preflight
  branch_exists_local "$canonical" "$branch" || die 20 "branch '$branch' does not exist locally in $canonical"
  [[ -e "$target" ]] && die 20 "target path already exists: $target"

  acquire_lock "$wt_root"
  branch_issue_key_validate_unique "$repo" "$branch" "$allow_duplicate_issue_key"
  local original_branch
  original_branch=$(git_in "$canonical" rev-parse --abbrev-ref HEAD)
  local original_clean=1
  is_clean "$canonical" || original_clean=0
  if (( original_clean == 0 )); then
    if (( commit_wip == 1 )); then
      local cur; cur=$(git_in "$canonical" rev-parse --abbrev-ref HEAD)
      [[ "$cur" == "$branch" ]] || die 20 "--commit-wip requires canonical to be on '$branch' (currently '$cur'); switch first or commit manually"
      info "$(dim "+ committing WIP snapshot on $branch (--no-verify)")"
      git_in "$canonical" add -A >/dev/null || die 1 "git add failed"
      git_in "$canonical" commit --no-verify --quiet -m "WIP: pre-wt-adopt snapshot ($branch)" >/dev/null || die 1 "git commit failed"
    else
      die 20 "canonical $canonical has uncommitted changes; commit, stash, or pass --commit-wip"
    fi
  fi
  info "$(dim "detaching canonical from $branch onto $base")"
  if ! git_in "$canonical" switch --detach "$base" >/dev/null 2>&1; then
    die 1 "could not detach canonical to $base"
  fi
  info "$(dim "→ creating worktree $target for existing branch $branch")"
  if ! git_in "$canonical" worktree add "$target" "$branch" >/dev/null 2>&1; then
    git_in "$canonical" switch "$original_branch" >/dev/null 2>&1 || true
    die 1 "git worktree add failed"
  fi

  # Park canonical on default_branch
  if branch_exists_local "$canonical" "$default_branch"; then
    git_in "$canonical" switch "$default_branch" >/dev/null 2>&1 \
      || warn "couldn't switch canonical to $default_branch (continuing detached)"
  else
    git_in "$canonical" switch -c "$default_branch" "$base" >/dev/null 2>&1 \
      || warn "couldn't create $default_branch from $base"
  fi

  green "adopted "
  printf 'branch=%s worktree=%s id=%s\n' "$branch" "$target" "$id"
  info "canonical now parked on $(git_in "$canonical" rev-parse --abbrev-ref HEAD)"

  # Plugin emit
  wt_plugin_emit_lifecycle "wt:worktree-created" "$repo" "$id" "$target" "$branch"
}

cmd_move() {
  guard_forbidden
  local branch="" repo_override="" allow_duplicate_issue_key=0
  while (($#)); do
    case "$1" in
      --repo) repo_override="${2:-}"; shift 2 ;;
      --allow-duplicate-issue-key) allow_duplicate_issue_key=1; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) [[ -z "$branch" ]] && branch="$1" || die 10 "unexpected positional: $1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die 10 "usage: wt move [--repo <name>] [--allow-duplicate-issue-key] <branch>"

  # Move only makes sense from inside canonical: cwd has the dirty work to relocate.
  local repo cwd_info kind
  if [[ -n "$repo_override" ]]; then
    local _check=$(cfg_repo_get "$repo_override" path 2>/dev/null)
    [[ "$_check" == "null" || -z "$_check" ]] && die 10 "unknown repo: $repo_override (configured: $(cfg_repos | tr '\n' ' '))"
    repo="$repo_override"
  elif cwd_info=$(repo_for_cwd 2>/dev/null); then
    repo="${cwd_info%% *}"
    kind="${cwd_info##* }"
    [[ "$kind" == "canonical" ]] || die 20 "wt move must be run from a canonical checkout (cwd is a $kind under repo '$repo'). Use 'wt new' instead."
  else
    die 20 "wt move must be run from inside a configured canonical checkout (or pass --repo)"
  fi

  validate_branch_shape "$repo" "$branch"

  local id canonical wt_root base default_branch target
  id=$(derive_id "$branch")
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  base=$(cfg_repo_get "$repo" base)
  default_branch=$(cfg_repo_get "$repo" default_branch)
  target="$wt_root/$id"

  guard_forbidden "$target"
  [[ -d "$canonical/.git" || -f "$canonical/.git" ]] || die 20 "canonical $canonical is not a git repo"

  # Refuse if canonical isn't on default branch: 'wt adopt' is the right tool for
  # moving a non-default branch with its uncommitted work into a worktree.
  local cur
  cur=$(git_in "$canonical" rev-parse --abbrev-ref HEAD)
  [[ "$cur" == "$default_branch" ]] || die 20 "canonical is on '$cur', not '$default_branch'. Use 'wt adopt $cur --commit-wip' or switch first."

  # Refuse if clean: 'wt new' is clearer when there's nothing to relocate.
  if is_clean "$canonical"; then
    die 20 "canonical is clean; nothing to move. Use 'wt new $branch' instead."
  fi

  acquire_lock "$wt_root"
  branch_issue_key_validate_unique "$repo" "$branch" "$allow_duplicate_issue_key"
  [[ -e "$target" ]] && die 20 "target path already exists: $target"
  wt_dir_registered "$repo" "$target" && die 20 "target path already registered as a worktree"
  branch_exists_local "$canonical" "$branch" && die 20 "branch already exists locally: $branch"
  branch_exists_origin "$canonical" "$branch" && die 20 "branch already exists on origin: $branch"

  # Stash staged + unstaged + untracked in canonical, with a recognizable label so
  # we can find and roll back if anything below fails.
  local stash_msg="wt-move: relocating work to $branch"
  info "$(dim "\u2192 stashing uncommitted work in $canonical (\"$stash_msg\")")"
  if ! git_in "$canonical" stash push --include-untracked --quiet -m "$stash_msg" >/dev/null; then
    die 1 "git stash failed in canonical"
  fi

  info "$(dim "\u2192 fetching $base in $canonical (best-effort)")"
  git_in "$canonical" fetch --quiet origin "${base#origin/}" 2>/dev/null || warn "git fetch failed; proceeding with local refs"

  info "$(dim "\u2192 creating worktree $target from $base on new branch $branch")"
  if ! git_in "$canonical" worktree add -b "$branch" "$target" "$base" >/dev/null; then
    # Rollback: restore the stash so the user does not lose work.
    if git_in "$canonical" stash pop --quiet >/dev/null 2>&1; then
      die 50 "git worktree add failed; restored stash to canonical"
    else
      die 60 "git worktree add failed AND stash pop failed; work is in stash@{0} ($stash_msg). Run 'git -C $canonical stash list'."
    fi
  fi
  git_in "$target" branch --unset-upstream 2>/dev/null || true

  copy_worktreeinclude_files "$canonical" "$target"

  # Pop the stash into the new worktree. On conflict, keep the stash and warn;
  # do NOT exit non-zero since the worktree and branch are valid \u2014 user can resolve.
  info "$(dim "\u2192 restoring stashed work in $target")"
  if ! git_in "$target" stash pop --quiet >/dev/null 2>&1; then
    warn "git stash pop in worktree had conflicts; stash kept (run 'git -C $target stash list'). Resolve in $target."
  fi

  green "moved "
  printf 'work from canonical to worktree=%s branch=%s id=%s\n' "$target" "$branch" "$id"

  # Plugin emit: best-effort dispatch to enabled plugins.
  wt_plugin_emit_lifecycle "wt:worktree-created" "$repo" "$id" "$target" "$branch"
}

cmd_pr() {
  guard_forbidden
  local num="${1:-}"
  [[ "$num" =~ ^[0-9]+$ ]] || die 10 "usage: wt pr <number>"
  local repo
  local cwd_info
  if cwd_info=$(repo_for_cwd 2>/dev/null); then
    repo="${cwd_info%% *}"
  else
    repo=$(cfg_repos | head -1)
  fi
  local branch="pr-$num" id canonical wt_root target
  id="$branch"
  canonical=$(cfg_repo_get "$repo" path)
  wt_root=$(cfg_repo_get "$repo" worktree_root)
  target="$wt_root/$id"
  validate_branch_shape "$repo" "$branch"
  guard_forbidden "$target"

  acquire_lock "$wt_root"
  [[ -e "$target" ]] && die 20 "target path already exists: $target"
  branch_exists_local "$canonical" "$branch" && die 20 "branch already exists locally: $branch (use 'wt cd $id' or 'wt reap')"

  info "$(dim "→ fetching pull/$num/head as $branch")"
  if ! git_in "$canonical" fetch origin "pull/$num/head:$branch" >/dev/null 2>&1; then
    die 1 "could not fetch pull/$num/head — does the PR exist?"
  fi
  info "$(dim "→ creating worktree $target")"
  if ! git_in "$canonical" worktree add "$target" "$branch" >/dev/null 2>&1; then
    git_in "$canonical" branch -D "$branch" >/dev/null 2>&1 || true
    die 1 "git worktree add failed"
  fi
  green "fetched PR #$num "
  printf 'worktree=%s branch=%s\n' "$target" "$branch"

  # Plugin emit
  wt_plugin_emit_lifecycle "wt:worktree-created" "$repo" "$id" "$target" "$branch"
}

cmd_list() {
  local repo
  for repo in $(cfg_repos); do
    local canonical wt_root
    canonical=$(cfg_repo_get "$repo" path)
    wt_root=$(cfg_repo_get "$repo" worktree_root)
    printf '%s\n' "$(green "[$repo]") canonical=$canonical worktree_root=$wt_root"
    {
      printf 'ID\tSHA\tBRANCH\n'
      while IFS= read -r record; do
        wt_record_fields "$record" _repo id path _rp_path branch sha is_canonical
        [[ "$is_canonical" == "worktree" ]] || continue
        [[ -n "$branch" ]] || branch="(detached)"
        if path_under_forbidden "$_rp_path"; then branch="$branch (external)"; fi
        printf '%s\t%s\t%s\n' "$id" "$sha" "$branch"
      done < <(wt_each_worktree "$repo")
    } | column -t -s $'\t' | sed '1 s/^/  /; 2,$ s/^/  /'
  done
}

cmd_status() {
  local refresh=0
  while (($#)); do case "$1" in --refresh) refresh=1; shift;; *) die 10 "unknown flag: $1";; esac; done
  local repo
  for repo in $(cfg_repos); do
    local canonical wt_root default_branch
    canonical=$(cfg_repo_get "$repo" path)
    wt_root=$(cfg_repo_get "$repo" worktree_root)
    default_branch=$(cfg_repo_get "$repo" default_branch)
    (( refresh == 1 )) && git_in "$canonical" fetch origin "$default_branch" --quiet 2>/dev/null || true
    printf '%s\n' "$(green "[$repo]")"
    {
      printf 'ID\tCLEAN\tPUSHED\tREACH\tBRANCH\n'
      while IFS= read -r record; do
        wt_record_fields "$record" _repo id path _rp_path branch _sha is_canonical
        [[ "$is_canonical" == "worktree" ]] || continue
        [[ -n "$branch" ]] || branch="(detached)"
        if path_under_forbidden "$_rp_path"; then branch="$branch (external)"; fi
        local state c p r
        state=$(worktree_state_record "$path" "$default_branch")
        wt_record_fields "$state" c p r
        printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$c" "$p" "$r" "$branch"
      done < <(wt_each_worktree "$repo")
    } | column -t -s $'\t' | sed 's/^/  /'
  done
}

cmd_audit() {
  # Read-only check: list worktree branches with commits not yet on origin/<default>.
  # TSV output, one row per finding: repo\tid\tbranch\tahead\tstatus[\tdetail]
  # status in: unpushed | ahead-of-upstream | pushed-unmerged
  # Designed for machine consumption (PAI SessionStart hook).
  local fetch=1
  while (($#)); do
    case "$1" in
      --no-fetch) fetch=0; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) die 10 "unknown arg: $1" ;;
    esac
  done
  local repo
  for repo in $(cfg_repos); do
    local canonical default_branch
    canonical=$(cfg_repo_get "$repo" path)
    default_branch=$(cfg_repo_get "$repo" default_branch)
    (( fetch == 1 )) && git_in "$canonical" fetch origin "$default_branch" --quiet 2>/dev/null || true
    while IFS= read -r record; do
      wt_record_fields "$record" _repo id path _rp_path branch _sha is_canonical
      [[ "$is_canonical" == "worktree" ]] || continue
      [[ -n "$branch" ]] || continue
      [[ -d "$path" ]] || continue
      reachable_from "$path" "$default_branch" && continue
      local status detail ahead_of_main ahead_of_up upstream
      ahead_of_main=$(git_in "$path" rev-list --count "origin/$default_branch..HEAD" 2>/dev/null || echo 0)
      if upstream=$(git_in "$path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
        ahead_of_up=$(git_in "$path" rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)
        if [[ "$ahead_of_up" != "0" ]]; then
          status="ahead-of-upstream"
          detail="$ahead_of_up ahead of $upstream"
        else
          status="pushed-unmerged"
          detail="on $upstream, not merged to $default_branch"
        fi
      else
        status="unpushed"
        detail="no upstream"
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$repo" "$id" "$branch" "$ahead_of_main" "$status" "$detail"
    done < <(wt_each_worktree "$repo")
  done
}

cmd_reap() {
  guard_forbidden
  local force=0 dry=0 ids=()
  while (($#)); do
    case "$1" in
      --force) force=1; shift ;;
      --dry-run) dry=1; shift ;;
      -*) die 10 "unknown flag: $1" ;;
      *) ids+=("$1"); shift ;;
    esac
  done
  (( ${#ids[@]} > 0 )) || die 10 "usage: wt reap [--force] [--dry-run] <id>..."

  local id repo
  for id in "${ids[@]}"; do
    local record path branch rp_path
    record=$(wt_resolve_id "$id") || die 20 "no worktree '$id' in any configured repo"
    wt_record_fields "$record" repo id path rp_path branch _sha _is_canonical
    local canonical wt_root default_branch
    canonical=$(cfg_repo_get "$repo" path)
    wt_root=$(cfg_repo_get "$repo" worktree_root)
    default_branch=$(cfg_repo_get "$repo" default_branch)

    # Safety
    local refusals=()
    mapfile -t refusals < <(worktree_reap_refusals "$path" "$default_branch")
    if (( ${#refusals[@]} > 0 && force == 0 )); then
      printf '%s %s [%s]\n' "$(red REFUSE)" "$id" "$(IFS=,; echo "${refusals[*]}")"
      (( dry == 1 )) && continue
      die 70 "reap refused without --force (id=$id)"
    fi

    if (( dry == 1 )); then
      printf '%s %s\n' "$(yellow DRY)" "would reap id=$id path=$path branch=(see status)"
      continue
    fi

    acquire_lock "$wt_root"
    # 1. remove worktree
    if [[ -d "$path" ]]; then
      if ! git_in "$canonical" worktree remove "$path" --force >/dev/null 2>&1; then
        die 60 "git worktree remove failed; run 'wt repair' to reconcile"
      fi
    else
      git_in "$canonical" worktree prune >/dev/null 2>&1 || true
    fi
    # 2. delete branch if reachable from origin/<default>
    if [[ -n "$branch" ]]; then
      if git_in "$canonical" cherry "origin/$default_branch" "$branch" 2>/dev/null | grep -q '^+'; then
        warn "branch '$branch' has commits not in origin/$default_branch; not deleting"
      else
        git_in "$canonical" branch -D "$branch" >/dev/null 2>&1 || warn "branch -D failed for $branch"
        # 3. delete the (auto)pushed remote branch too, but only when its tip
        # is already reachable from origin/<default> — reap must never destroy
        # the only copy of unmerged work. Without this, autopushed remotes
        # outlive every reap and accumulate as stale branches on origin.
        local remote_sha
        remote_sha=$(git_in "$canonical" ls-remote origin "refs/heads/$branch" 2>/dev/null | cut -f1)
        if [[ -n "$remote_sha" ]]; then
          if git_in "$canonical" merge-base --is-ancestor "$remote_sha" "origin/$default_branch" 2>/dev/null; then
            git_in "$canonical" push --no-verify origin --delete "$branch" >/dev/null 2>&1 \
              || warn "could not delete remote branch origin/$branch"
          else
            warn "remote branch origin/$branch not fully merged; keeping"
          fi
        fi
      fi
    fi
    release_lock
    green "reaped "
    printf 'id=%s branch=%s\n' "$id" "$branch"

    # Plugin emit: AFTER worktree removal so plugins can clean up tab state.
    wt_plugin_emit_lifecycle "wt:worktree-removed" "$repo" "$id" "$path" "$branch" "reap"
  done
}

cmd_cd() {
  local id="${1:-}"
  [[ -n "$id" ]] || die 10 "usage: wt cd <id>"
  local record repo path _id _rp_path _branch _sha _is_canonical
  record=$(wt_resolve_id "$id") || die 20 "no worktree '$id' in any configured repo"
  wt_record_fields "$record" repo _id path _rp_path _branch _sha _is_canonical
  if path_under_forbidden "$(rp "$path")"; then warn "external (OMP-managed) worktree: $path"; fi
  echo "$path"
}

